          "label": "Subtitle",
          "default": "Treatments Delivered"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Reached a massive milestone of half a million sessions, bringing relief to 15,000 total users.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats List (SH)",
      "blocks": [
        { "type": "stat", "settings": { "number": "500,000+", "subtitle": "Treatments Delivered" } },
        { "type": "stat", "settings": { "number": "15.4x", "subtitle": "Growth Velocity" } },
        { "type": "stat", "settings": { "number": "90%", "subtitle": "App-to-Relief Conversion" } },
        { "type": "stat", "settings": { "number": "Unwavering\\nEngagement", "subtitle": "" } }
      ]

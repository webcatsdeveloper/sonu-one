<section class="sonu-careers-design-role section-{{ section.id }}" style="
  {% if section.settings.bg_gradient != blank %}
    background: {{ section.settings.bg_gradient }};
  {% elsif section.settings.bg_color != blank %}
    background-color: {{ section.settings.bg_color }};
  {% endif %}
  --padding-top: {{ section.settings.padding_top | default: 80 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 120 }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 60 }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 80 }}px;
  --border-radius-bottom: {{ section.settings.border_radius_bottom | default: 80 }}px;
  --border-radius-bottom-mobile: {{ section.settings.border_radius_bottom_mobile | default: 40 }}px;
">
  <style>
    #shopify-section-{{ section.id }} .sonu-careers-design-role {
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
      border-bottom-left-radius: var(--border-radius-bottom);
      border-bottom-right-radius: var(--border-radius-bottom);
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .design-role-container {
      max-width: 1060px;
      margin: 0 auto;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .design-role-header {
      margin-bottom: 40px;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .design-role-heading {
      color: #001755;
      margin: 0;
      text-align: inherit;
    }
    #shopify-section-{{ section.id }} .design-role-body {
      display: flex;
      justify-content: center;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .design-role-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      max-width: 480px;
      width: 100%;
      gap: 32px;
    }
    #shopify-section-{{ section.id }} .design-role-desc {
      color: #1e1e1e;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .design-role-desc p {
      margin: 0;
    }
    #shopify-section-{{ section.id }} .btn.design-role-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 36px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 500;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    #shopify-section-{{ section.id }} .btn.design-role-btn:hover {
      transform: scale(1.02);
      opacity: 0.95;
    }

    /* Highlights styling overrides */
    #shopify-section-{{ section.id }} .highlight-times {
      font-family: 'Times New Roman', Times, Georgia, serif !important;
      font-style: italic !important;
    }
    #shopify-section-{{ section.id }} .highlight-pp {
      font-family: var(--font-highlight--family, serif) !important;
      font-style: var(--font-highlight--style, italic) !important;
    }

    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .sonu-careers-design-role {
        padding-top: var(--padding-top-mobile) !important;
        padding-bottom: var(--padding-bottom-mobile) !important;
        border-bottom-left-radius: var(--border-radius-bottom-mobile);
        border-bottom-right-radius: var(--border-radius-bottom-mobile);
      }
      #shopify-section-{{ section.id }} .design-role-container {
        text-align: left;
      }
      #shopify-section-{{ section.id }} .design-role-header {
        margin-bottom: 24px;
        text-align: left;
      }
      #shopify-section-{{ section.id }} .design-role-body {
        justify-content: flex-start;
      }
      #shopify-section-{{ section.id }} .design-role-content {
        gap: 24px;
        max-width: 100%;
      }
    }
  </style>

  <div class="design-role-container page-width">
    {%- if section.settings.heading != blank -%}
      <div class="design-role-header">
        {%- assign formatted_heading = section.settings.heading 
          | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
          | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
        <h2 class="design-role-heading typography-{{ section.settings.heading_style | default: 'h2' }}" 
            style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}">
          {{ formatted_heading }}
        </h2>
      </div>
    {%- endif -%}

    <div class="design-role-body">
      <div class="design-role-content">
        {%- if section.settings.description != blank -%}
          <div class="design-role-desc typography-{{ section.settings.description_style | default: 'p' }}"
               style="{% render 'sonu-typography-style', preset: section.settings.description_style, prefix: 'description_style', settings: section.settings %}">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn design-role-btn"
             style="
               background-color: {{ section.settings.button_bg_color | default: '#001755' }};
               color: {{ section.settings.button_text_color | default: '#ffffff' }};
               {% render 'sonu-typography-style', preset: section.settings.button_style, prefix: 'button_style', settings: section.settings %}
             ">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>


<section class="custom-heading-section-{{ section.id }}">
  <style>
    .custom-heading-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .custom-heading-{{ section.id }} {
      font-family: {{ section.settings.font_family }};
      color: {{ section.settings.text_color }};
      text-align: {{ section.settings.text_align }};
      margin: 0;
      width: 100%;
    }

    {% if section.settings.hide_desktop %}
    @media screen and (min-width: 750px) {
      .custom-heading-section-{{ section.id }} {
        display: none !important;
      }
    }
    {% endif %}

    {% if section.settings.hide_mobile %}
    @media screen and (max-width: 749px) {
      .custom-heading-section-{{ section.id }} {
        display: none !important;
      }
    }
    {% endif %}
  </style>

  <div class="page-width">
    {%- assign tag = section.settings.heading_style | default: 'h2' -%}
    <{{ tag }} class="custom-heading-{{ section.id }} typography-{{ section.settings.heading_style | default: 'h2' }}">
      {% render 'heading-br', heading: section.settings.heading %}
    </{{ tag }}>
  </div>
</section>

{% schema %}
{
  "name": "Custom Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Your Heading Here"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "Paragraph (P)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_style_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_style_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font Family",
      "options": [
        {
          "value": "var(--font-heading--family)",
          "label": "Theme Heading Font"
        },
        {
          "value": "var(--font-body--family)",
          "label": "Theme Body Font"
        },
        {
          "value": "Arial, sans-serif",
          "label": "Arial"
        },
        {
          "value": "Georgia, serif",
          "label": "Georgia"
        }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Custom Heading"
    }
  ]
}
{% endschema %}
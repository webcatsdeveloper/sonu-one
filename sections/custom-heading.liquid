<section class="custom-heading-section-{{ section.id }}">
  <style>
    .custom-heading-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .custom-heading-{{ section.id }} {
      font-family: {{ section.settings.font_family }};
      color: {{ section.settings.text_color }};
      text-align: {{ section.settings.text_align }};
      margin: 0;
      width: 100%;
    }

    {% if section.settings.hide_desktop %}
    @media screen and (min-width: 750px) {
      .custom-heading-section-{{ section.id }} {
        display: none !important;
      }
    }
    {% endif %}

    {% if section.settings.hide_mobile %}
    @media screen and (max-width: 749px) {
      .custom-heading-section-{{ section.id }} {
        display: none !important;
      }
    }
    {% endif %}
  </style>

  <div class="page-width">
    {%- assign tag = section.settings.heading_style | default: 'h2' -%}
    <{{ tag }} class="custom-heading-{{ section.id }} typography-{{ section.settings.heading_style | default: 'h2' }}">
      {% render 'heading-br', heading: section.settings.heading %}
    </{{ tag }}>
  </div>
</section>

{% schema %}
{
  "name": "Custom Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Your Heading Here"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph (P)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font Family",
      "options": [
        {
          "value": "var(--font-heading--family)",
          "label": "Theme Heading Font"
        },
        {
          "value": "var(--font-body--family)",
          "label": "Theme Body Font"
        },
        {
          "value": "Arial, sans-serif",
          "label": "Arial"
        },
        {
          "value": "Georgia, serif",
          "label": "Georgia"
        }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on Mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Custom Heading"
    }
  ]
}
{% endschema %}
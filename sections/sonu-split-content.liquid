{{ 'sonu-custom.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .split-content {
    padding-top: {{ section.settings.padding_top | default: 120 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 120 }}px !important;
  }
  
  /* Fix: Expanded width allocation to ensure the main heading layout fits cleanly onto 2 lines on desktop */
  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .split-left {
      flex: 1.3 !important; /* Allocates more proportional grid room to the left block */
    }
    #shopify-section-{{ section.id }} .split-left .main-heading {
      max-width: 840px !important;
      width: 100% !important;
      display: block !important;
      white-space: normal !important;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .split-content {
      padding-top: {{ section.settings.mobile_padding_top | default: 72 }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom | default: 48 }}px !important;
    }
  }
</style>
<section class="split-content section">
  <div class="sonu-split-page-width">
    <div class="split-grid">

      <div class="split-left sonu-blur-in">
        {%- assign heading_style = 'color: ' | append: section.settings.heading_color -%}
        {% render 'sonu-section-header',
          heading: section.settings.heading,
          heading_tag: section.settings.heading_tag,
          heading_style_preset: section.settings.heading_style,
          heading_class: 'main-heading',
          heading_style: heading_style,
          small_heading: section.settings.small_heading,
          small_heading_style_preset: section.settings.small_heading_style,
          subheading: section.settings.subheading,
          subheading_style_preset: section.settings.subheading_style,
          text_align: 'left',
          animate: false
        %}
      </div>

      <div class="split-right animate-blur delay-1">

        {% if section.settings.description != blank %}
          <div class="description typography-{{ section.settings.description_style | default: 'p' }}" style="{% render 'sonu-typography-style', preset: section.settings.description_style, prefix: 'description_style', settings: section.settings %}">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <div class="features">
          {% for block in section.blocks %}
            <div class="feature-item">

              {% if block.settings.icon_svg != blank %}
                <div class="icon">
                  {{ block.settings.icon_svg }}
                </div>
              {% endif %}

              <p class="typography-{{ section.settings.feature_text_style | default: 'p' }}" style="{% render 'sonu-typography-style', preset: section.settings.feature_text_style, prefix: 'feature_text_style', settings: section.settings %}">{{ block.settings.text }}</p>

            </div>
          {% endfor %}
        </div>

      </div>

    </div>
  </div>
</section>


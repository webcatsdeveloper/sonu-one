{{ 'sonu-custom.css' | asset_url | stylesheet_tag }}

<section class="science-bg-area">
  <div id="logos-and-carousel-{{ section.id }}" class="sonu-logos-and-carousel">
    <div class="sonu-logos-and-carousel-inner">
      
      {%- comment -%} Render Logos Content snippet {%- endcomment -%}
      {%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}
      {%- if logo_blocks.size > 0 -%}
        {% render 'sonu-logo-list-content',
          is_combined: true,
          heading: section.settings.logo_heading,
          heading_tag: section.settings.logo_heading_tag,
          heading_style: section.settings.logo_heading_style,
          subheading_style: section.settings.logo_subheading_style,
          description: section.settings.logo_description,
          button_text: section.settings.logo_button_text,
          button_link: section.settings.logo_button_link,
          button_bg: section.settings.logo_button_bg,
          button_text_color: section.settings.logo_button_text_color,
          blocks: logo_blocks,
          section_id: section.id,
          section_settings: section.settings,
          heading_style_prefix: 'logo_heading_style',
          subheading_style_prefix: 'logo_subheading_style'
        %}
      {%- endif -%}

      {%- comment -%} Render Premium Carousel Content snippet {%- endcomment -%}
      {%- assign card_blocks = section.blocks | where: 'type', 'card' -%}
      {%- if card_blocks.size > 0 -%}
        {% render 'sonu-premium-carousel-content',
          is_combined: true,
          bg_color: 'transparent',
          bg_image: blank,
          text_color: section.settings.carousel_text_color,
          text_align: section.settings.carousel_text_align,
          heading: section.settings.carousel_heading,
          heading_tag: section.settings.carousel_heading_tag,
          heading_style: section.settings.carousel_heading_style,
          blocks: card_blocks,
          section_id: section.id,
          section_settings: section.settings,
          heading_style_prefix: 'carousel_heading_style'
        %}
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .sonu-logos-and-carousel {
    position: relative;
    {% if section.settings.bg_color_desktop_solid != blank and section.settings.bg_color_desktop_solid != 'transparent' %}
      background-color: {{ section.settings.bg_color_desktop_solid }};
      background-image: none;
    {% else %}
      background: {{ section.settings.bg_color_desktop | default: 'linear-gradient(90deg, #F2EDF4 0%, #EEF1FA 45%, #E8F2FF 100%)' }};
    {% endif %}
    padding-top: {{ section.settings.padding_top | default: 80 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px !important;
    overflow: hidden;
  }
  .typography-h3, .text-block.h3, h3, .h3, .text-block.h3 > *, .typography-h3 > *{
  font-weight:600;
}

  /* Background image with opacity overlay */
  #shopify-section-{{ section.id }} .sonu-logos-and-carousel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 }};
    {% else %}
      opacity: 0;
    {% endif %}
    pointer-events: none;
    z-index: 0;
  }

  /* Ensure content sits above the pseudo-element */
  #shopify-section-{{ section.id }} .sonu-logos-and-carousel > * {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .sonu-logos-and-carousel {
      {% if section.settings.bg_color_mobile_solid != blank and section.settings.bg_color_mobile_solid != 'transparent' %}
        background-color: {{ section.settings.bg_color_mobile_solid }};
        background-image: none;
      {% else %}
        background: {{ section.settings.bg_color_mobile | default: 'linear-gradient(90deg, #F2EDF4 0%, #EEF1FA 45%, #E8F2FF 100%)' }};
      {% endif %}
      padding-top: {{ section.settings.mobile_padding_top | default: 60 }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom | default: 60 }}px !important;
    }

    #shopify-section-{{ section.id }} .sonu-logos-and-carousel::before {
      {% if section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1000 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: {{ section.settings.mobile_bg_image_opacity | default: section.settings.bg_image_opacity | divided_by: 100.0 }};
      {% elsif section.settings.bg_image != blank %}
        background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: {{ section.settings.mobile_bg_image_opacity | default: section.settings.bg_image_opacity | divided_by: 100.0 }};
      {% else %}
        opacity: 0;
      {% endif %}
    }
  }

  .sonu-logos-and-carousel-inner {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  @media (max-width: 768px) {
    .sonu-logos-and-carousel-inner {
      gap: 40px;
    }
  }

  /* Reset nested components background and padding inside the combined wrapper */
  #shopify-section-{{ section.id }} .logo-section {
    background: transparent !important;
    background-image: none !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  #shopify-section-{{ section.id }} .logo-section::before {
    display: none !important;
  }
  #shopify-section-{{ section.id }} .premium-carousel {
    background: transparent !important;
    background-image: none !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  #shopify-section-{{ section.id }} .carousel-heading {
    text-align: center !important;
    width: 100% !important;
    margin: 0 auto !important;
    max-width: 879px !important;
  }
  
  #shopify-section-{{ section.id }} .sonu-section-header {
    width: 100% !important;
    justify-items: center !important;
    text-align: center !important;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .carousel-heading {
      text-align: center !important;
      width: 100% !important;
      margin: 0 auto !important;
      max-width: 100% !important;
      padding: 0 !important;
    }
  }
</style>


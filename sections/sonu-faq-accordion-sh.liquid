<div class="faq-accordion-section-wrapper section-{{ section.id }}-wrapper" style="
  {% if section.settings.bg_gradient != blank %}
    background: {{ section.settings.bg_gradient }};
  {% elsif section.settings.bg_color != blank %}
    background-color: {{ section.settings.bg_color }};
  {% endif %}
  --padding-top: {{ section.settings.padding_top | default: 100 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 60 }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 60 }}px;
  {% if section.settings.enable_bottom_curve %}
    border-bottom-left-radius: {{ section.settings.curve_radius_desktop | default: 80 }}px;
    border-bottom-right-radius: {{ section.settings.curve_radius_desktop | default: 80 }}px;
    margin-bottom: -{{ section.settings.curve_radius_desktop | default: 80 }}px;
    position: relative;
    z-index: 100;
  {% endif %}
">
<style>
  {% if section.settings.enable_bottom_curve %}
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 100;
    }
    @media screen and (max-width: 768px) {
      .section-{{ section.id }}-wrapper {
        border-bottom-left-radius: {{ section.settings.curve_radius_mobile | default: 40 }}px !important;
        border-bottom-right-radius: {{ section.settings.curve_radius_mobile | default: 40 }}px !important;
        margin-bottom: -{{ section.settings.curve_radius_mobile | default: 40 }}px !important;
      }
    }
  {% endif %}
</style>
  <section class="sonu-faq-accordion section-{{ section.id }} page-width">
    <div class="faq-accordion-container">
      
      <!-- Left Column: Title -->
      <div class="faq-accordion-title-col">
        {%- if section.settings.heading != blank -%}
          {%- assign formatted_heading = section.settings.heading 
            | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
            | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
          <h2 class="faq-accordion-heading typography-{{ section.settings.heading_style | default: 'h2' }}"
              style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}">
            {{ formatted_heading }}
          </h2>
        {%- endif -%}
      </div>

      <!-- Right Column: Accordion list -->
      <div class="faq-accordion-list-col">
        <sonu-faq-accordion class="faq-accordion-list">
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank and block.settings.answer != blank -%}
              <div class="faq-accordion-item {% if forloop.first and section.settings.open_first %}active{% endif %}" {{ block.shopify_attributes }}>
                <button class="faq-accordion-trigger typography-{{ section.settings.question_style | default: 'h5' }}"
                        aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}"
                        style="{% render 'sonu-typography-style', preset: section.settings.question_style, prefix: 'question_style', settings: section.settings %}">
                  <span>{{ block.settings.question }}</span>
                  <span class="faq-accordion-chevron">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </button>
                <div class="faq-accordion-content" style="{% if forloop.first and section.settings.open_first %}max-height: none;{% else %}max-height: 0;{% endif %}">
                  <div class="faq-accordion-content-inner typography-{{ section.settings.answer_style | default: 'p' }}"
                       style="{% render 'sonu-typography-style', preset: section.settings.answer_style, prefix: 'answer_style', settings: section.settings %}">
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </sonu-faq-accordion>
      </div>

    </div>
  </section>
</div>

<style>
  .faq-accordion-section-wrapper {
    width: 100%;
    position: relative;
  }
  .sonu-faq-accordion {
    padding-top: var(--padding-top) !important;
    padding-bottom: var(--padding-bottom) !important;
  }
  .faq-accordion-container {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    column-gap: 120px;
    align-items: start;
  }
  .faq-accordion-title-col {
    position: sticky;
    top: 120px;
    width: 100%;
    align-self: start;
    height: fit-content;
  }
  .faq-accordion-heading {
    color: #000000;
    margin: 0;
    text-align: left;
    white-space: nowrap;
    margin-top: -8px;
  }
  .faq-accordion-list-col {
    width: 100%;
  }
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-top: 1px solid #dbdbdb;
  }
  .faq-accordion-item {
    width: 100%;
    border-bottom: 1px solid #dbdbdb;
  }
  .faq-accordion-item:last-child {
    border-bottom: none;
  }
  .faq-accordion-item {
    transition: all 0.3s ease;
  }
  .faq-accordion-trigger {
    width: 100%;
    background: none;
    border: none;
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    color: #1e1e1e;
    text-align: left;
    transition: color 0.2s ease;
  }
  .faq-accordion-trigger:hover {
    color: #001755;
  }
  .faq-accordion-trigger span {
    padding-right: 20px;
  }
  .faq-accordion-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1e1e1e;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }
  .faq-accordion-item.active .faq-accordion-chevron {
    transform: rotate(-180deg);
  }
  .faq-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq-accordion-content-inner {
    padding-bottom: 24px;
    color: #1e1e1e;
    line-height: 1.6;
  }
  .faq-accordion-content-inner p {
    margin: 0 0 12px 0;
  }
  .faq-accordion-content-inner p:last-child {
    margin: 0;
  }

  /* Highlight Fonts Override */
  .section-{{ section.id }} .highlight-times {
    font-family: 'Times New Roman', Times, Georgia, serif !important;
    font-style: italic !important;
  }
  .section-{{ section.id }} .highlight-pp {
    font-family: var(--font-highlight--family, serif) !important;
    font-style: var(--font-highlight--style, italic) !important;
  }

  @media screen and (max-width: 768px) {
    .sonu-faq-accordion {
      padding-top: var(--padding-top-mobile) !important;
      padding-bottom: var(--padding-bottom-mobile) !important;
    }
    .faq-accordion-container {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 40px;
    }
    .faq-accordion-title-col {
      position: static;
    }
    .faq-accordion-heading {
      color: #001755;
      white-space: normal;
    }
    .faq-accordion-trigger {
      padding: 20px 0;
    }
    .faq-accordion-content-inner {
      padding-bottom: 20px;
    }
  }
</style>

<script>
if (!customElements.get('sonu-faq-accordion')) {
  customElements.define('sonu-faq-accordion', class extends HTMLElement {
    constructor() {
      super();
    }
    connectedCallback() {
      // Handle block select in theme editor
      this.addEventListener('shopify:block:select', (event) => {
        const selectedItem = event.target.closest('.faq-accordion-item');
        if (!selectedItem) return;
        this.toggleItem(selectedItem);
      });

      // Event delegation for clicks
      this.addEventListener('click', (e) => {
        const button = e.target.closest('.faq-accordion-trigger');
        if (!button) return;
        e.preventDefault();
        const item = button.closest('.faq-accordion-item');
        if (item) this.toggleItem(item);
      });

      // Initialize heights on load after DOM parsing is complete for this element
      requestAnimationFrame(() => {
        setTimeout(() => {
          this.querySelectorAll('.faq-accordion-item.active').forEach(item => {
            const content = item.querySelector('.faq-accordion-content');
            if (content) {
              content.style.maxHeight = content.scrollHeight + 'px';
            }
          });
        }, 100);
      });

      // Recalculate heights on resize
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          this.querySelectorAll('.faq-accordion-item.active').forEach(item => {
            const content = item.querySelector('.faq-accordion-content');
            if (content) {
              content.style.maxHeight = content.scrollHeight + 'px';
            }
          });
        }, 150);
      });
    }

    toggleItem(clickedItem) {
      const allItems = this.querySelectorAll('.faq-accordion-item');
      const isActive = clickedItem.classList.contains('active');
      const content = clickedItem.querySelector('.faq-accordion-content');
      const button = clickedItem.querySelector('.faq-accordion-trigger');

      // Close all
      allItems.forEach(i => {
        i.classList.remove('active');
        const c = i.querySelector('.faq-accordion-content');
        const b = i.querySelector('.faq-accordion-trigger');
        if (c) c.style.maxHeight = '0px';
        if (b) b.setAttribute('aria-expanded', 'false');
      });

      // Open if it wasn't active
      if (!isActive) {
        clickedItem.classList.add('active');
        if (button) button.setAttribute('aria-expanded', 'true');
        if (content) content.style.maxHeight = content.scrollHeight + 'px';
      }
    }
  });
}
</script>


{% comment %}
  SoundHealth Custom Features Grid Section
{% endcomment %}

{{ 'sonu-custom.css' | asset_url | stylesheet_tag }}

{% style %}
  .custom-features-sh-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }
  .custom-about-features-container-sh {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .custom-features-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 80px; /* Increased gap between cards */
    align-items: start;
  }
  .custom-feature-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  @media screen and (min-width: 768px) {
    .custom-feature-item:nth-child(even) {
      margin-top: 120px; /* Staggered grid effect */
    }
  }
  .custom-feature-image-wrapper {
    width: 100%;
    margin-bottom: 24px;
    background-color: #f4f4f4; /* Placeholder background */
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .custom-feature-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .custom-feature-heading {
    margin: 0 0 16px 0;
  }
  .custom-feature-desc {
    margin: 0;
    max-width: 400px; /* Forces exact text wrapping seen in Figma */
  }
  .custom-feature-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
    padding: 16px 48px; /* Exact button dimensions from Figma */
    background-color: #0A1C40;
    color: #FFFFFF;
    text-decoration: none;
    border-radius: 999px;
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 600;
    font-size: 13px; /* Slightly smaller uppercase font */
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
  }
  .custom-feature-btn:hover {
    opacity: 0.9;
    color: #FFFFFF;
  }

  @media screen and (max-width: 767px) {
    .custom-features-sh-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .custom-features-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .custom-feature-item:nth-child(even) {
      margin-top: 0; /* Remove stagger on mobile */
    }
    .custom-feature-desc {
      max-width: 310px; /* Constrain text wrap specifically for mobile */
    }
    .custom-feature-btn {
      padding: 12px 32px; /* Narrower button padding on mobile */
      text-transform: none; /* Title case on mobile per Figma */
      letter-spacing: normal;
    }
  }
{% endstyle %}

<div class="custom-features-sh-{{ section.id }}">
  <div class="custom-about-features-container-sh">
    <div class="custom-features-grid">
      {%- for block in section.blocks -%}
        <div class="custom-feature-item" {{ block.shopify_attributes }}>
          <div class="custom-feature-image-wrapper">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'custom-feature-image', loading: 'lazy' }}
            {%- endif -%}
          </div>
          {%- if block.settings.heading != blank -%}
            <div class="custom-feature-heading typography-{{ section.settings.heading_style | default: 'h6' }}"
                 style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}; color: {{ section.settings.heading_color }};">
              {{ block.settings.heading }}
            </div>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <div class="custom-feature-desc typography-{{ section.settings.desc_style | default: 'p' }}"
                 style="{% render 'sonu-typography-style', preset: section.settings.desc_style, prefix: 'desc_style', settings: section.settings %}; color: {{ section.settings.desc_color }};">
              {{ block.settings.description }}
            </div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="custom-feature-btn">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features Grid (SH)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f2f5fc"

{%- liquid
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign highlight_color = section.settings.highlight_color | default: text_color
  assign highlight_span = '<span class="ste-serif-highlight" style="color: ' | append: highlight_color | append: ';">'
-%}

<div id="shopify-section-{{ section.id }}" class="custom-stats-wrapper ste-section-wrapper {% if section.settings.hide_mobile %}ste-hide-mobile{% endif %}" style="
  {% if section.settings.bg_gradient != blank %}
    background: {{ section.settings.bg_gradient }};
  {% else %}
    background-color: {{ bg_color }}; 
  {% endif %}
  --text-color: {{ text_color }}; 
  --padding-top: {{ section.settings.padding_top }}px; 
  --padding-bottom: {{ section.settings.padding_bottom }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
">

  {% if section.settings.enable_top_gradient %}
  <div class="ste-gradient-overlay" style="
    background: linear-gradient(to bottom, {{ section.settings.gradient_color }} {{ section.settings.gradient_stop }}%, transparent {{ section.settings.gradient_fade_end }}%);
    pointer-events: none;
  "></div>
  {% endif %}

  <!-- DESKTOP VERSION -->
  <div class="ste-desktop-only">
    <div class="ste-media-canvas-wrap ste-animate-blur">
      {% if section.settings.desktop_image != blank %}
        <img
          src="{{ section.settings.desktop_image | image_url: width: 1600 }}"
          alt=""
          class="ste-responsive-img"
          loading="lazy"
          style="object-position: {{ section.settings.desktop_image_position }};"
        >
      {% endif %}
    </div>

    <div class="ste-page-container">
      <div class="ste-layout-grid">
        
        <!-- Column 1: Editorial Content -->
        <div class="ste-main-editorial-content ste-animate-blur ste-delay-4">
          {% if section.settings.heading != blank %}
            {% assign ste_formatted_heading = section.settings.heading
              | replace: '[[', highlight_span
              | replace: ']]', '</span>'
              | newline_to_br
            %}
            {%- assign head_tag = section.settings.heading_tag | default: 'h2' -%}
            <{{ head_tag }} class="ste-main-title typography-{{ head_tag }}" style="color: {{ section.settings.heading_color | default: text_color }};">
              {{ ste_formatted_heading }}
            </{{ head_tag }}>
          {% endif %}

          {% if section.settings.description != blank %}
            {%- assign desc_tag = section.settings.description_style | default: 'p' -%}
            <div class="ste-body-description typography-{{ desc_tag }}" style="color: {{ section.settings.description_color | default: text_color }};">
              {{ section.settings.description | replace: '[[', highlight_span | replace: ']]', '</span>' }}
            </div>
          {% endif %}
        </div>

        <!-- Column 2: Center Spacer for the background face -->
        <div class="ste-grid-spacer"></div>

        <!-- Column 3: Metrics Sidebar (Stats Cards) -->
        <div class="ste-metrics-sidebar">
          {% for block in section.blocks %}
            {%- liquid
              assign stat_num = block.settings.stat_number | default: block.settings.number
              assign stat_lab = block.settings.stat_label | default: block.settings.heading
              assign stat_desc = block.settings.description | default: block.settings.text
              assign block_prefix = block.settings.prefix
              assign block_postfix = block.settings.postfix
            -%}
            <div class="ste-metric-card ste-animate-blur ste-delay-{{ forloop.index }}" style="background: {{ block.settings.card_bg_color }}; border-color: {{ block.settings.card_border_color }};" {{ block.shopify_attributes }}>
              
              <div class="ste-metric-card-header">
                {%- assign counter_tag = section.settings.counter_style | default: 'h1' -%}
                <div class="ste-metric-num-display typography-{{ counter_tag }}" style="color: {{ block.settings.number_color | default: text_color }};">
                  {% if block_prefix != blank %}
                    <span class="ste-metric-prefix" style="color: {{ block.settings.number_color | default: text_color }};">
                      {{ block_prefix | replace: '[[', highlight_span | replace: ']]', '</span>' }}
                    </span>
                  {% endif %}

                  {%- liquid
                    assign number_clean = stat_num | replace: '[[', '' | replace: ']]', '' | replace: 'x', '' | replace: 'X', '' | replace: '%', '' | replace: 'k+', '' | replace: 'K+', '' | replace: '+', ''
                  -%}
                  <span class="ste-metric-counter" data-target="{{ number_clean }}" style="color: {{ block.settings.number_color | default: text_color }};">0</span>

                  {% if block_postfix != blank %}
                    <span class="ste-metric-postfix" style="color: {{ block.settings.number_color | default: text_color }};">
                      {{ block_postfix | replace: '[[', highlight_span | replace: ']]', '</span>' }}
                    </span>
                  {% else %}
                    {% if stat_num contains 'x' or stat_num contains 'X' %}
                      <span class="ste-metric-postfix" style="color: {{ block.settings.number_color | default: text_color }};">X</span>
                    {% elsif stat_num contains '%' %}
                      <span class="ste-metric-postfix" style="color: {{ block.settings.number_color | default: text_color }};">%</span>
                    {% elsif stat_num contains 'k+' or stat_num contains 'K+' %}
                      <span class="ste-metric-postfix" style="color: {{ block.settings.number_color | default: text_color }};">k+</span>
                    {% endif %}
                  {% endif %}
                </div>

                {% if stat_lab != blank %}
                  {%- assign stat_tag = section.settings.block_heading_tag | default: 'h3' -%}
                  <{{ stat_tag }} class="ste-metric-label typography-{{ stat_tag }}" style="color: {{ block.settings.label_color | default: text_color }};">
                    {{ stat_lab | replace: '[[', highlight_span | replace: ']]', '</span>' }}
                  </{{ stat_tag }}>
                {% endif %}
              </div>

              {% if stat_desc != blank %}
                {%- assign caption_tag = section.settings.caption_style | default: 'p' -%}
                <div class="ste-metric-caption typography-{{ caption_tag }}" style="color: {{ block.settings.caption_color | default: text_color }};">
                  {{ stat_desc | replace: '[[', highlight_span | replace: ']]', '</span>' }}
                </div>
              {% endif %}

            </div>
          {% endfor %}
        </div>

      </div>
    </div>
  </div>

  <!-- MOBILE VERSION -->
  <div class="ste-mobile-only" style="width: 100%;">
    <div class="custom-stats-container">

      

      <!-- Top Image -->
      {%- assign mobile_img = section.settings.mobile_image | default: section.settings.desktop_image -%}
      {% if mobile_img != blank %}
        <div class="ste-mobile-hero-image-wrap">
          <img src="{{ mobile_img | image_url: width: 1000 }}" alt="" class="ste-mobile-hero-img" loading="lazy">
        </div>
      {% endif %}

      <!-- Vertical Stats List -->
      <div class="ste-mobile-stats-list">
        {% for block in section.blocks %}
          {%- liquid
            assign stat_num = block.settings.stat_number | default: block.settings.number
            assign stat_lab = block.settings.stat_label | default: block.settings.heading
            assign stat_desc = block.settings.description | default: block.settings.text
            assign block_prefix = block.settings.prefix
            assign block_postfix = block.settings.postfix

            assign formatted_num = stat_num | replace: '[[', highlight_span | replace: ']]', '</span>'
            assign formatted_prefix = block_prefix | replace: '[[', highlight_span | replace: ']]', '</span>'
            assign formatted_postfix = block_postfix | replace: '[[', highlight_span | replace: ']]', '</span>'
          -%}
          
          {% if forloop.first == false %}
            <hr class="ste-mobile-divider">
          {% endif %}
          
          <div class="ste-mobile-stat-item" {{ block.shopify_attributes }}>
            <div class="ste-mobile-stat-number typography-{{ counter_tag }}" style="color: {{ block.settings.number_color | default: text_color }};">
              {% if block_prefix != blank %}{{ formatted_prefix }}{% endif %}{{ formatted_num }}{% if block_postfix != blank %}{{ formatted_postfix }}{% endif %}
            </div>
            
            {% if stat_lab != blank %}
              {%- assign m_heading_tag = section.settings.block_heading_tag | default: 'div' -%}
              <{{ m_heading_tag }} class="ste-mobile-stat-label typography-{{ m_heading_tag }}" style="color: {{ block.settings.label_color | default: text_color }};">
                {{ stat_lab | replace: '[[', highlight_span | replace: ']]', '</span>' }}
              </{{ m_heading_tag }}>
            {% endif %}
            
            {% if stat_desc != blank %}
              <div class="ste-mobile-stat-desc typography-{{ caption_tag }}" style="color: {{ block.settings.caption_color | default: '#666' }};">
                {{ stat_desc | replace: '[[', highlight_span | replace: ']]', '</span>' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
<!-- Top Heading -->
      {% if section.settings.heading != blank %}
        {% assign ste_formatted_heading_mobile = section.settings.heading
          | replace: '[[', highlight_span
          | replace: ']]', '</span>'
          | newline_to_br
        %}
        <{{ section.settings.heading_tag | default: 'h2' }} class="ste-mobile-heading typography-{{ section.settings.heading_tag | default: 'h2' }}" style="color: {{ section.settings.heading_color | default: text_color }};">
          {{ ste_formatted_heading_mobile }}
        </{{ section.settings.heading_tag | default: 'h2' }}>
      {% endif %}
      {% if section.settings.show_description_mobile and section.settings.description != blank %}
        <div class="ste-mobile-description ste-body-description typography-{{ desc_tag }}" style="color: {{ section.settings.description_color | default: text_color }};">
          {{ section.settings.description | replace: '[[', highlight_span | replace: ']]', '</span>' }}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap');

@font-face {
  font-family: 'pp-editorial';
  src: url('{{ "PPEditorialNew-Regular.otf" | asset_url }}') format('opentype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'PP Editorial New';
  src: url('{{ "PPEditorialNew-Regular.otf" | asset_url }}') format('opentype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* ==========================================================================
   DESKTOP GLOBAL & LAYOUT SYSTEM
   ========================================================================== */
.ste-section-wrapper {
  padding-top: var(--padding-top, 100px);
  padding-bottom: var(--padding-bottom, 100px);
  overflow: hidden;
  position: relative;
  width: 100%;
}

/* Gradient Overlay Styles */
.ste-gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300px;
  z-index: 2;
}

.ste-page-container {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 80px;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 3;
}

.ste-layout-grid {
  display: grid;
  grid-template-columns: 460px 1fr 395px;
  gap: 20px;
  align-items: center;
  width: 100%;
}

/* ==========================================================================
   LEFT COMPONENT PIECE: EDITORIAL TEXT
   ========================================================================== */
.ste-main-editorial-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ste-main-title {
  margin: 0 0 32px 0;
  text-align: left;
}

.ste-serif-highlight {
  font-family: var(--font-highlight--family, 'pp-editorial', 'PP Editorial New', serif) !important;
  font-style: normal;
}

.ste-body-description {
  color: rgba(30, 30, 30, 0.85);
}

.ste-body-description p {
  margin: 0 0 16px 0;
}

.ste-body-description p:last-child {
  margin-bottom: 0;
}

.ste-body-description p strong {
  display: block;
  font-size: 18px;
  font-weight: 600;
  color: #1E1E1E;
  {% comment %} margin-bottom: 8px; {% endcomment %}
}

/* ==========================================================================
   MIDDLE COMPONENT PIECE: BACKGROUND MEDIA CANVAS
   ========================================================================== */
.ste-media-canvas-wrap {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.ste-media-canvas-wrap .ste-responsive-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  border-radius: 0;
}

.ste-responsive-img {
  display: block;
  max-width: 100%;
}

.ste-desktop-only { display: block !important; }
.ste-mobile-only { display: none !important; }

/* ==========================================================================
   RIGHT COMPONENT PIECE: METRIC CARDS
   ========================================================================== */
.ste-metrics-sidebar {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ste-metric-card {
  box-sizing: border-box;
  width: 100%;
  background: #FAF6F0 !important;
  border-radius: 16px;
  padding: 24px 28px;
  display: flex;
  flex-direction: column;
  border: none !important;
  box-shadow: 0 4px 20px rgba(61, 27, 3, 0.02);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.ste-metric-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(61, 27, 3, 0.05);
}

.ste-metric-card-header {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 12px;
}

.ste-metric-num-display,
.ste-metric-num-display * {
  line-height: 1;
}

.ste-metric-counter {
  font-weight: inherit;
}

.ste-metric-prefix,
.ste-metric-postfix {
  font-size: 0.6em;
}

.ste-metric-label {
  margin: 0;
  color: #3D1B03 !important;
}

.ste-metric-caption {
  color: rgba(30, 30, 30, 0.8) !important;
  text-align: left;
}

/* ==========================================================================
   ANIMATION MODULE ENGINE
   ========================================================================== */
.ste-animate-blur {
  opacity: 0;
  filter: blur(8px);
  transform: translateY(15px);
  animation: steBlurFadeIn 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.ste-delay-1 { animation-delay: .10s; }
.ste-delay-2 { animation-delay: .20s; }
.ste-delay-3 { animation-delay: .30s; }
.ste-delay-4 { animation-delay: .40s; }

@keyframes steBlurFadeIn {
  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}


@media (max-width: 768px) {
  .ste-mobile-heading {
    text-align: left !important;
    margin-top: 50px!important;
    margin-bottom: 24px;
    
  }
}
/* ==========================================================================
   TABLET RESPONSIVE INTERMEDIARY MODIFICATIONS
   ========================================================================== */
@media (max-width: 1100px) {
  .ste-page-container { padding: 0 40px; }
  .ste-layout-grid { grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: start; }
  .ste-main-editorial-content { grid-column: span 2; }
  .ste-main-title { font-size: 46px; }
}

/* ==========================================================================
   MOBILE RESPONSIVE SYSTEM
   ========================================================================== */
@media (max-width: 768px) {
  .ste-section-wrapper {
    padding-top: var(--padding-top-mobile, 60px);
    padding-bottom: var(--padding-bottom-mobile, 60px);
    min-height: auto;
  }

  .ste-desktop-only { display: none !important; }
  
  .ste-mobile-only {
    display: block !important;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .ste-mobile-hero-image-wrap {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .ste-mobile-hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ste-mobile-stats-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ste-mobile-stat-item {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ste-mobile-stat-number {
    margin-bottom: 8px;
  }

  .ste-mobile-stat-label {
    margin-bottom: 16px;
  }

  .ste-mobile-stat-desc {
    color: rgba(30, 30, 30, 0.85);
    max-width: 300px;
  }

  .ste-mobile-divider {
    border: none;
    border-top: 1px solid rgba(84, 54, 32, 0.15);
    margin: 32px 0;
    width: 100%;
  }

  .ste-mobile-heading {
    margin: 0 0 24px 0;
    text-align: center;
  }

  .ste-mobile-description {
    margin-top: 5px;
    text-align: left;
    width: 100%;
  }
}

@media screen and (max-width: 768px) {
  .ste-hide-mobile {
    display: none !important;
  }
}
</style>

<script>
(function() {
  function initCounters(container) {
    const steCounters = container.querySelectorAll(".ste-metric-counter[data-target]");
    
    function animateCounter(counter, target) {
      let current = 0;
      const duration = 1400;
      const increment = target / (duration / 16);

      function updateCounter() {
        current += increment;
        if (current < target) {
          counter.innerText = Math.floor(current);
          requestAnimationFrame(updateCounter);
        } else {
          counter.innerText = target;
        }
      }
      updateCounter();
    }

    if ('IntersectionObserver' in window) {
      const steObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const counter = entry.target;
            const target = parseFloat(counter.dataset.target);
            if (!isNaN(target)) {
              animateCounter(counter, target);
            }
            observer.unobserve(counter);
          }
        });
      }, { threshold: 0.2 });

      steCounters.forEach(counter => steObserver.observe(counter));
    } else {
      steCounters.forEach(counter => {
        const target = parseFloat(counter.dataset.target);
        if (!isNaN(target)) animateCounter(counter, target);
      });
    }
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", () => initCounters(document));
  } else {
    initCounters(document);
  }

  // Run on Shopify theme editor load
  document.addEventListener('shopify:section:load', (event) => {
    initCounters(event.target);
  });
})();
</script>


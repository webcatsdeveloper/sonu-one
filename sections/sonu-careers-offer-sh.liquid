<section class="sonu-careers-offer section-{{ section.id }}" style="
  {% if section.settings.bg_gradient != blank %}
    background: {{ section.settings.bg_gradient }};
  {% elsif section.settings.bg_color != blank %}
    background-color: {{ section.settings.bg_color }};
  {% endif %}
  --padding-top: {{ section.settings.padding_top | default: 100 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 60 }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
">
  <style>
    #shopify-section-{{ section.id }} .sonu-careers-offer {
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
    }
    #shopify-section-{{ section.id }} .careers-offer-container {
      /* Spacing and width constraints are handled by global .page-width */
    }
    #shopify-section-{{ section.id }} .careers-offer-content {
      display: grid;
      grid-template-columns: 480px 480px;
      column-gap: 100px;
      justify-content: center;
      align-items: start;
    }
    #shopify-section-{{ section.id }} .careers-offer-image-col img {
      display: block;
      width: 480px;
      height: 480px;
      border-radius: 0 !important;
      object-fit: cover;
    }
    #shopify-section-{{ section.id }} .careers-offer-text-col {
      display: flex;
      flex-direction: column;
      gap: 36px;
      align-items: flex-start;
      max-width: 480px;
    }
    #shopify-section-{{ section.id }} .careers-offer-heading {
      color: #001755;
      margin: 0;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .careers-offer-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 28px;
      width: 100%;
      max-width: 410px;
    }
    #shopify-section-{{ section.id }} .careers-offer-item {
      position: relative;
      padding-left: 24px;
      margin: 0;
      color: #1e1e1e;
      font-family: 'Instrument Sans', sans-serif !important;
      font-size: 20px;
      line-height: 32px;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .careers-offer-item::before {
      content: "•";
      position: absolute;
      left: 0;
      top: -2px;
      color: #1e1e1e;
      font-size: 1.3em;
      line-height: 32px;
    }
    #shopify-section-{{ section.id }} .careers-offer-bottom-text {
      max-width: 960px;
      margin: 80px auto 0 auto;
      text-align: center;
      color: #1e1e1e;
      font-family: 'Instrument Sans', sans-serif !important;
      font-size: 20px;
      line-height: 32px;
    }

    /* Highlights styling overrides */
    #shopify-section-{{ section.id }} .highlight-times {
      font-family: 'Times New Roman', Times, Georgia, serif !important;
      font-style: italic !important;
    }
    #shopify-section-{{ section.id }} .highlight-pp {
      font-family: var(--font-highlight--family, serif) !important;
      font-style: var(--font-highlight--style, italic) !important;
    }

    @media screen and (max-width: 1200px) {
      #shopify-section-{{ section.id }} .careers-offer-content {
        grid-template-columns: 1fr;
        column-gap: 0;
        row-gap: 48px;
      }
      #shopify-section-{{ section.id }} .careers-offer-image-col {
        width: 100%;
        display: flex;
        justify-content: center;
      }
      #shopify-section-{{ section.id }} .careers-offer-image-col img {
        width: 100%;
        max-width: 100%;
        height: auto;
        aspect-ratio: 1;
      }
      #shopify-section-{{ section.id }} .careers-offer-list {
        max-width: 100%;
      }
    }
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .sonu-careers-offer {
        padding-top: var(--padding-top-mobile) !important;
        padding-bottom: var(--padding-bottom-mobile) !important;
      }
      #shopify-section-{{ section.id }} .careers-offer-item {
        font-size: 18px;
        line-height: 28px;
      }
      #shopify-section-{{ section.id }} .careers-offer-bottom-text {
        margin-top: 48px;
        font-size: 18px;
        line-height: 28px;
      }
    }
  </style>

  <div class="careers-offer-container page-width">
    <div class="careers-offer-content">
      <!-- Left: Text Column -->
      <div class="careers-offer-text-col">
        {%- if section.settings.heading != blank -%}
          {%- assign formatted_heading = section.settings.heading 
            | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
            | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
          <h2 class="careers-offer-heading typography-{{ section.settings.heading_style | default: 'h2' }}" 
              style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}">
            {{ formatted_heading }}
          </h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="careers-offer-list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                {%- assign formatted_text = block.settings.text 
                  | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
                  | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
                <li class="careers-offer-item typography-{{ section.settings.description_style | default: 'p' }}" 
                    style="{% render 'sonu-typography-style', preset: section.settings.description_style, prefix: 'description_style', settings: section.settings %}"
                    {{ block.shopify_attributes }}>
                  {{ formatted_text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Right: Image Column -->
      <div class="careers-offer-image-col">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" 
               alt="{{ section.settings.image.alt | default: 'What we offer image' | escape }}"
               width="{{ section.settings.image.width | default: 520 }}"
               height="{{ section.settings.image.height | default: 520 }}"
               loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.bottom_text != blank -%}
      {%- assign formatted_bottom_text = section.settings.bottom_text 
        | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
        | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
      <div class="careers-offer-bottom-text typography-{{ section.settings.bottom_text_style | default: 'p' }}"
           style="{% render 'sonu-typography-style', preset: section.settings.bottom_text_style, prefix: 'bottom_text_style', settings: section.settings %}">
        {{ formatted_bottom_text }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}

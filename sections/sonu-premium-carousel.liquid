{{ 'sonu-custom.css' | asset_url | stylesheet_tag }}
<section class="science-bg-area">
  {% render 'sonu-premium-carousel-content',
    is_combined: false,
    bg_color: section.settings.bg_color,
    bg_image: section.settings.bg_image,
    text_color: section.settings.text_color,
    text_align: section.settings.text_align,
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    mobile_padding_top: section.settings.mobile_padding_top,
    mobile_padding_bottom: section.settings.mobile_padding_bottom,
    heading: section.settings.heading,
    heading_tag: section.settings.heading_tag,
    heading_style: section.settings.heading_style,
    blocks: section.blocks,
    section_id: section.id,
    section_settings: section.settings
  %}
</section>





{% schema %}
{
  "name": "Premium Carousel",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (HTML allowed)"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading type",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style Preset",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "Paragraph (P)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_style_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_style_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",

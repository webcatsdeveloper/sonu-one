{% liquid
  assign announcement_text = section.settings.announcement_text
%}

<div id="announcement-bar-{{ section.id }}" class="custom-announcement-bar">
  <div class="custom-announcement-bar__inner typography-{{ section.settings.text_style | default: 'p' }}">
    {{ announcement_text }}
  </div>
</div>

<style>
#announcement-bar-{{ section.id }} {
  width: 100%;
  background: #FFFFFF;
  border-top: 1px solid #E5E5E5;
  border-bottom: 1px solid #E5E5E5;
  position: relative;
  z-index: 10;
}

#announcement-bar-{{ section.id }} .custom-announcement-bar__inner {
  max-width: 1920px;
  margin: 0 auto;
  min-height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 10px 20px!important;
  text-align: center;
  color: #001755;
}

@media screen and (max-width: 768px) {
  #announcement-bar-{{ section.id }} .custom-announcement-bar__inner {
    min-height: 40px;
    padding: 8px 16px!important;
  }
}
</style>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "tag": "section",
  "class": "custom-announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "SONU is one of TIME's 2025 Best Inventions"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text Style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph (P)" }
      ],
      "default": "p"
    }
  ],
  "presets": [
    {
      "name": "Custom Announcement Bar"
    }
  ]
}
{% endschema %}
{% liquid
  assign announcement_text = section.settings.announcement_text
%}

<div id="announcement-bar-{{ section.id }}" class="custom-announcement-bar">
  <div class="custom-announcement-bar__inner typography-{{ section.settings.text_style | default: 'p' }}" style="{% render 'sonu-typography-style', preset: section.settings.text_style, prefix: 'text_style', settings: section.settings %}">
    {{ announcement_text }}
  </div>
</div>

<style>
#announcement-bar-{{ section.id }} {
  width: 100%;
  background: #FFFFFF;
  border-top: 1px solid #E5E5E5;
  border-bottom: 1px solid #E5E5E5;
  position: relative;
  z-index: 10;
}

#announcement-bar-{{ section.id }} .custom-announcement-bar__inner {
  max-width: 1920px;
  margin: 0 auto;
  min-height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 10px 20px!important;
  text-align: center;
  color: #001755;
}

@media screen and (max-width: 768px) {
  #announcement-bar-{{ section.id }} .custom-announcement-bar__inner {
    min-height: 40px;
    padding: 8px 16px!important;
  }
}
</style>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "tag": "section",
  "class": "custom-announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "SONU is one of TIME's 2025 Best Inventions"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text Style",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "Paragraph (P)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "p"
    },
    {
      "type": "range",
      "id": "text_style_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.text_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "text_style_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.text_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "text_style_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.text_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "text_style_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.text_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "text_style_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.text_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "text_style_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.text_style == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Custom Announcement Bar"
    }
  ]
}
{% endschema %}
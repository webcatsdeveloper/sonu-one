{% comment %}
  SoundHealth Custom Medical Advisor Profiles Section
  Displays a list of advisors with image on the left and text on the right (desktop), stacked on mobile.
{% endcomment %}

{{ 'sonu-custom.css' | asset_url | stylesheet_tag }}

{% style %}
  {% if section.settings.enable_bottom_curve %}
    #MainContent {
      overflow-y: visible !important;
      z-index: 2 !important;
    }
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 100;
    }
    .advisor-profiles-sh-{{ section.id }} {
      border-bottom-left-radius: {{ section.settings.curve_radius_desktop | default: 65 }}px;
      border-bottom-right-radius: {{ section.settings.curve_radius_desktop | default: 65 }}px;
      margin-bottom: -{{ section.settings.curve_radius_desktop | default: 65 }}px;
      position: relative;
    }
    @media screen and (max-width: 768px) {
      .advisor-profiles-sh-{{ section.id }} {
        border-bottom-left-radius: {{ section.settings.curve_radius_mobile | default: 28 }}px !important;
        border-bottom-right-radius: {{ section.settings.curve_radius_mobile | default: 28 }}px !important;
        margin-bottom: -{{ section.settings.curve_radius_mobile | default: 28 }}px !important;
      }
    }
  {% endif %}

  .advisor-profiles-sh-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 768px) {
    .advisor-profiles-sh-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .advisor-profile-container {
    max-width: 1200px;
    margin: 0 auto 80px auto;
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  
  .advisor-profile-container:last-child {
    margin-bottom: 0;
  }

  .advisor-image-wrapper {
    width: 100%;
    margin-bottom: 30px;
  }
  
  .advisor-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .advisor-text-wrapper {
    width: 100%;
    padding: 0 20px;
  }

  .advisor-name {
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
    font-size: 28px;
    font-weight: 400;
  }

  .advisor-subtitle {
    color: {{ section.settings.text_color }};
    font-size: 14px;
    margin: 0 0 30px 0;
  }

  .advisor-bio {
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .advisor-bio p {
    margin-bottom: 20px;
  }
  
  .advisor-bio p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 768px) {
    .advisor-profile-container {
      flex-direction: row;
      align-items: flex-start;
      gap: 80px;
      padding: 0 40px;
    }
    .advisor-profile-container:nth-child(even) {
      flex-direction: row-reverse;
    }
    .advisor-image-wrapper {
      width: 45%;
      margin-bottom: 0;
    }
    .advisor-text-wrapper {
      width: 55%;
      padding-top: 20px;
      padding-left: 0;
      padding-right: 0;
    }
    .advisor-name {
      font-size: 32px;
    }
  }
{% endstyle %}

<div class="advisor-profiles-sh-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="advisor-profile-container" {{ block.shopify_attributes }}>
      <div class="advisor-image-wrapper">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="advisor-text-wrapper">
        {%- if block.settings.name != blank -%}
          <h3 class="advisor-name typography-{{ section.settings.name_style | default: 'h3' }}" style="{% render 'sonu-typography-style', preset: section.settings.name_style, prefix: 'name_style', settings: section.settings %}; color: {{ section.settings.heading_color }};">{{ block.settings.name }}</h3>
        {%- endif -%}
        
        {%- if block.settings.subtitle != blank -%}
          <div class="advisor-subtitle typography-{{ section.settings.subtitle_style | default: 'p' }}" style="{% render 'sonu-typography-style', preset: section.settings.subtitle_style, prefix: 'subtitle_style', settings: section.settings %}; color: {{ section.settings.text_color }};">{{ block.settings.subtitle }}</div>
        {%- endif -%}
        
        {%- if block.settings.bio != blank -%}
          <div class="advisor-bio typography-{{ section.settings.bio_style | default: 'p' }}" style="{% render 'sonu-typography-style', preset: section.settings.bio_style, prefix: 'bio_style', settings: section.settings %}; color: {{ section.settings.text_color }};">
            {{ block.settings.bio }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>


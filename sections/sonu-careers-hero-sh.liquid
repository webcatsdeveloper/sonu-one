<section class="sonu-careers-hero section-{{ section.id }}" style="
  {% if section.settings.bg_gradient != blank %}
    background: {{ section.settings.bg_gradient }};
  {% elsif section.settings.bg_color != blank %}
    background-color: {{ section.settings.bg_color }};
  {% endif %}
  --padding-top: {{ section.settings.padding_top | default: 80 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 60 }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
">
  <style>
    #shopify-section-{{ section.id }} .sonu-careers-hero {
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
    }
    #shopify-section-{{ section.id }} .careers-hero-container {
      /* Spacing and width constraints are handled by global .page-width */
    }
    #shopify-section-{{ section.id }} .careers-hero-header {
      text-align: center;
      margin-bottom: 56px;
    }
    #shopify-section-{{ section.id }} .careers-hero-heading {
      color: #001755;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .careers-hero-content {
      display: grid;
      grid-template-columns: 480px 480px;
      column-gap: 100px;
      justify-content: center;
      align-items: start;
    }
    #shopify-section-{{ section.id }} .careers-hero-image-col img {
      display: block;
      width: 480px;
      height: 480px;
      border-radius: 0 !important;
      object-fit: cover;
    }
    #shopify-section-{{ section.id }} .careers-hero-text-col {
      display: flex;
      flex-direction: column;
      gap: 36px;
      align-items: flex-start;
      max-width: 480px;
    }
    #shopify-section-{{ section.id }} .careers-hero-desc {
      color: #1e1e1e;
      font-family: 'Instrument Sans', sans-serif !important;
      font-size: 24px;
      line-height: 36px;
      font-weight: 400;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .careers-hero-desc p {
      margin: 0 0 16px 0;
    }
    #shopify-section-{{ section.id }} .careers-hero-desc p:last-child {
      margin-bottom: 0;
    }
    #shopify-section-{{ section.id }} .btn.careers-hero-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 36px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 500;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    #shopify-section-{{ section.id }} .btn.careers-hero-btn:hover {
      transform: scale(1.02);
      opacity: 0.95;
    }

    /* Highlights styling overrides */
    #shopify-section-{{ section.id }} .highlight-times {
      font-family: 'Times New Roman', Times, Georgia, serif !important;
      font-style: italic !important;
    }
    #shopify-section-{{ section.id }} .highlight-pp {
      font-family: var(--font-highlight--family, serif) !important;
      font-style: var(--font-highlight--style, italic) !important;
    }

    @media screen and (max-width: 1200px) {
      #shopify-section-{{ section.id }} .careers-hero-content {
        grid-template-columns: 1fr;
        column-gap: 0;
        row-gap: 48px;
      }
      #shopify-section-{{ section.id }} .careers-hero-image-col {
        order: 2;
        width: 100%;
        display: flex;
        justify-content: center;
      }
      #shopify-section-{{ section.id }} .careers-hero-image-col img {
        width: 100%;
        max-width: 100%;
        height: auto;
        aspect-ratio: 1;
      }
      #shopify-section-{{ section.id }} .careers-hero-text-col {
        order: 1;
        width: 100%;
        align-items: flex-start;
        text-align: left;
        max-width: 100%;
        gap: 24px;
      }
      #shopify-section-{{ section.id }} .careers-hero-desc {
        text-align: left;
      }
    }
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .sonu-careers-hero {
        padding-top: var(--padding-top-mobile) !important;
        padding-bottom: var(--padding-bottom-mobile) !important;
      }
      #shopify-section-{{ section.id }} .careers-hero-header {
        margin-bottom: 36px;
      }
      #shopify-section-{{ section.id }} .careers-hero-desc {
        font-size: 18px;
        line-height: 28px;
        text-align: left;
      }
    }
  </style>

  <div class="careers-hero-container page-width">
    {%- if section.settings.heading != blank -%}
      <div class="careers-hero-header">
        {%- assign formatted_heading = section.settings.heading 
          | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
          | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
        <h1 class="careers-hero-heading typography-{{ section.settings.heading_style | default: 'h1' }}" 
            style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}">
          {{ formatted_heading }}
        </h1>
      </div>
    {%- endif -%}

    <div class="careers-hero-content">
      <!-- Left: Image -->
      <div class="careers-hero-image-col">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" 
               alt="{{ section.settings.image.alt | default: 'Careers image' | escape }}"
               width="{{ section.settings.image.width | default: 520 }}"
               height="{{ section.settings.image.height | default: 520 }}"
               loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <!-- Right: Text & Button -->
      <div class="careers-hero-text-col">
        {%- if section.settings.description != blank -%}
          {%- assign formatted_desc = section.settings.description 
            | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
            | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
          <div class="careers-hero-desc typography-{{ section.settings.description_style | default: 'p' }}"
               style="{% render 'sonu-typography-style', preset: section.settings.description_style, prefix: 'description_style', settings: section.settings %}">
            {{ formatted_desc }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="careers-hero-btn-wrap">
            <a href="{{ section.settings.button_link | default: '#' }}" 
               class="btn careers-hero-btn typography-{{ section.settings.button_style | default: 'p' }}"
               style="background-color: {{ section.settings.btn_bg_color | default: '#001755' }}; color: {{ section.settings.btn_text_color | default: '#ffffff' }}; {% render 'sonu-typography-style', preset: section.settings.button_style, prefix: 'button_style', settings: section.settings %}">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{

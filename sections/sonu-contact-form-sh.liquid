<div class="contact-section-wrapper section-{{ section.id }}-wrapper" style="
  background-color: {{ section.settings.bg_color | default: '#eff2fc' }};
  --padding-top: {{ section.settings.padding_top | default: 100 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 60 }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 60 }}px;
">
<style>
  {% if section.settings.enable_bottom_curve %}
    #MainContent {
      overflow-y: visible !important;
      z-index: 2 !important;
    }
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 100;
    }
    .section-{{ section.id }}-wrapper {
      border-bottom-left-radius: {{ section.settings.curve_radius_desktop | default: 80 }}px;
      border-bottom-right-radius: {{ section.settings.curve_radius_desktop | default: 80 }}px;
      margin-bottom: -{{ section.settings.curve_radius_desktop | default: 80 }}px;
    }
    @media screen and (max-width: 768px) {
      .section-{{ section.id }}-wrapper {
        border-bottom-left-radius: {{ section.settings.curve_radius_mobile | default: 40 }}px !important;
        border-bottom-right-radius: {{ section.settings.curve_radius_mobile | default: 40 }}px !important;
        margin-bottom: -{{ section.settings.curve_radius_mobile | default: 40 }}px !important;
      }
    }
  {% endif %}

  .contact-container {
    max-width: 1140px;
    margin: 0 auto;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    column-gap: 80px;
    align-items: start;
    padding-left: 24px;
    padding-right: 24px;
  }

  .contact-main-col {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .contact-side-col {
    display: flex;
    flex-direction: column;
  }

  .contact-heading {
    color: #001755;
    margin: 0 0 40px 0;
    text-align: left;
    font-weight: 400;
  }

  .contact-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    row-gap: 32px;
  }

  .contact-form-field {
    display: flex;
    flex-direction: column;
  }

  .contact-form-field.full-width {
    grid-column: 1 / -1;
  }

  .contact-input {
    width: 100%;
    height: 60px;
    background: #ffffff;
    border: 1px solid #e1e4ec;
    border-radius: 40px;
    padding: 0 30px;
    font-size: 15px;
    color: #333;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    font-family: inherit;
  }
  
  .contact-input::placeholder {
    color: #b0b5c1;
    font-style: italic;
    font-weight: 300;
  }

  .contact-input:focus {
    border-color: #001755;
    box-shadow: 0 0 0 1px #001755;
  }

  textarea.contact-input {
    border-radius: 30px;
    resize: vertical;
    min-height: 180px;
    height: auto;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .contact-file-upload {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
    margin-bottom: 24px;
  }

  .contact-file-label {
    font-size: 14px;
    color: #333;
  }

  .contact-file-btn {
    background: #8fa5b5;
    color: #fff;
    border: none;
    padding: 12px 28px;
    border-radius: 30px;
    font-size: 13px;
    cursor: pointer;
    font-weight: 500;
    display: inline-block;
  }

  .contact-file-text {
    font-size: 12px;
    color: #666;
    font-style: italic;
  }

  .contact-submit {
    margin-top: 32px;
    background: #001755;
    color: #fff;
    border: none;
    height: 60px;
    width: 280px;
    border-radius: 40px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .contact-submit:hover {
    opacity: 0.9;
  }

  .contact-info-text {
    font-size: 16px;
    color: #333;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .contact-info-text p {
    margin: 0 0 10px 0;
  }

  .contact-links-list {
    display: flex;
    flex-direction: column;
  }

  .contact-link-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid #dbdbdb;
    color: #333;
    text-decoration: none;
    font-size: 18px;
    transition: color 0.3s ease;
  }

  .contact-link-item:first-child {
    border-top: none;
  }

  .contact-link-item:hover {
    color: #001755;
  }

  .contact-link-item svg {
    width: 24px;
    height: 24px;
    color: #001755;
  }

  .hide-mobile { display: flex; }
  .hide-desktop { display: none; }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .hide-mobile { display: none !important; }
    .hide-desktop { display: block; }

    .contact-container {
      grid-template-columns: 1fr;
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .contact-heading {
      margin-bottom: 20px;
    }

    .contact-form-grid {
      grid-template-columns: 1fr;
      row-gap: 16px;
    }

    .contact-mobile-bottom {
      margin-top: 40px;
      text-align: center;
    }

    .contact-mobile-note {
      font-size: 14px;
      color: #333;
      margin-bottom: 30px;
    }

    .contact-mobile-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 24px;
    }

    .contact-mobile-link {
      font-size: 14px;
      color: #333;
      text-decoration: underline;
    }

    .contact-file-upload {
      flex-wrap: wrap;
      gap: 16px;
    }

    .contact-file-label {
      width: 100%;
      margin-bottom: -4px;
    }

    .contact-submit {
      width: 100%;
      height: 56px;
      padding: 0;
      text-align: center;
      display: block;
    }

    .contact-input {
      height: 56px;
      border-radius: 30px;
      padding: 0 20px;
    }

    textarea.contact-input {
      min-height: 140px;
      padding-top: 16px;
      padding-bottom: 16px;
    }
  }
</style>

  <div class="contact-container">
    
    <!-- Left / Mobile Main Column -->
    <div class="contact-main-col">
      {%- if section.settings.heading != blank -%}
        <h1 class="contact-heading typography-{{ section.settings.heading_style | default: 'h1' }}"
            style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      <!-- Mobile Top Text -->
      <div class="contact-info-text hide-desktop">
        {{ section.settings.mobile_info_text }}
      </div>

      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-success" tabindex="-1" autofocus style="color: green; margin-bottom: 20px;">
            <p>Thanks for contacting us. We'll get back to you as soon as possible.</p>
          </div>
        {%- elsif form.errors -%}
          <div class="contact-error" style="color: red; margin-bottom: 20px;">
            <p>Please adjust the following:</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact-form-grid">
          <div class="contact-form-field">
            <input type="text" name="contact[first_name]" id="ContactForm-first_name" class="contact-input" placeholder="First Name*" required>
          </div>
          <div class="contact-form-field">
            <input type="text" name="contact[last_name]" id="ContactForm-last_name" class="contact-input" placeholder="Last Name*" required>
          </div>
          <div class="contact-form-field">
            <input type="email" name="contact[email]" id="ContactForm-email" class="contact-input" placeholder="Email*" required>
          </div>
          <div class="contact-form-field">
            <input type="tel" name="contact[phone]" id="ContactForm-phone" class="contact-input" placeholder="Phone">
          </div>
          <div class="contact-form-field full-width">
            <input type="text" name="contact[subject]" id="ContactForm-subject" class="contact-input" placeholder="Subject*" required>
          </div>
          <div class="contact-form-field full-width">
            <textarea name="contact[body]" id="ContactForm-body" class="contact-input" placeholder="Message" required></textarea>
          </div>
          
          <div class="contact-form-field full-width">
            <div class="contact-file-upload">
              <span class="contact-file-label">Upload Image</span>
              <label class="contact-file-btn">
                Choose File
                <input type="file" name="contact[attachment]" style="display:none;" accept="image/*" onchange="document.getElementById('file-text-{{ section.id }}').innerText = this.files[0] ? this.files[0].name : 'No file chosen'">
              </label>
              <span class="contact-file-text" id="file-text-{{ section.id }}">No file chosen</span>
            </div>
          </div>
        </div>
        
        <button type="submit" class="contact-submit">Submit</button>
      {%- endform -%}

      <!-- Mobile Bottom -->
      <div class="contact-mobile-bottom hide-desktop">
        <div class="contact-mobile-note">
          {{ section.settings.mobile_note_text }}
        </div>
        <div class="contact-mobile-links">
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link }}" class="contact-mobile-link">{{ block.settings.title }}</a>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <!-- Desktop Right Column -->
    <div class="contact-side-col hide-mobile">
      <div class="contact-info-text">
        {{ section.settings.info_text }}
      </div>
      
      <div class="contact-links-list">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link }}" class="contact-link-item" {{ block.shopify_attributes }}>
            <span>{{ block.settings.title }}</span>
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="9" y1="15" x2="15" y2="9"></line>
              <polyline points="9 9 15 9 15 15"></polyline>
            </svg>
          </a>
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Sonu Contact Form",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#eff2fc"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph (P)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_desktop",
      "label": "Heading Custom Size (Desktop)",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_mobile",
      "label": "Heading Custom Size (Mobile)",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "richtext",
      "id": "info_text",
      "label": "Desktop Info Text",
      "default": "<p>Our team is here to help<br>Email responses can take up to 72 hours.<br>Call us @ +1 (408) 384-8319</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_info_text",
      "label": "Mobile Top Text",
      "default": "<p>Our team is here to help</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_note_text",
      "label": "Mobile Bottom Note",
      "default": "<p>Email responses can take up to 72 hours.</p>"
    },
    {
      "type": "header",
      "content": "Curved Overlap"
    },
    {
      "type": "checkbox",
      "id": "enable_bottom_curve",
      "label": "Enable Curved Bottom & Overlap Next Section",
      "default": true
    },
    {
      "type": "range",
      "id": "curve_radius_desktop",
      "min": 0,
      "max": 300,
      "step": 5,
      "default": 160,
      "unit": "px",
      "label": "Curve Radius (Desktop)"
    },
    {
      "type": "range",
      "id": "curve_radius_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px",
      "label": "Curve Radius (Mobile)"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 100,
      "unit": "px",
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 120,
      "unit": "px",
      "label": "Padding Bottom"
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 60,
      "unit": "px",
      "label": "Padding Top (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 80,
      "unit": "px",
      "label": "Padding Bottom (Mobile)"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Side Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Link Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sonu Contact Form",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "title": "Need Help?"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "FAQs"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Helpful Videos"
          }
        }
      ]
    }
  ]
}
{% endschema %}

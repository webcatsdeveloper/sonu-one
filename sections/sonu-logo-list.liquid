<section class="science-bg-area">
  {% render 'sonu-logo-list-content',
    is_combined: false,
    bg_image: section.settings.bg_image,
    bg_image_opacity: section.settings.bg_image_opacity,
    mobile_bg_image_opacity: section.settings.mobile_bg_image_opacity,
    bg_color_desktop: section.settings.bg_color_desktop,
    bg_color_desktop_solid: section.settings.bg_color_desktop_solid,
    bg_color_mobile: section.settings.bg_color_mobile,
    bg_color_mobile_solid: section.settings.bg_color_mobile_solid,
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    mobile_padding_top: section.settings.mobile_padding_top,
    mobile_padding_bottom: section.settings.mobile_padding_bottom,
    heading: section.settings.heading,
    heading_tag: section.settings.heading_tag,
    heading_style: section.settings.heading_style,
    subheading_style: section.settings.subheading_style,
    description: section.settings.description,
    button_text: section.settings.button_text,
    button_link: section.settings.button_link,
    button_bg: section.settings.button_bg,
    button_text_color: section.settings.button_text_color,
    blocks: section.blocks,
    section_id: section.id,
    section_settings: section.settings
  %}
</section>

<style>
   .typography-h3, .text-block.h3, h3, .h3, .text-block.h3 > *, .typography-h3 > *{
  font-weight:500!important;
}
</style>
{{ 'sonu-custom.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Logo Carousel",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "mobile_bg_image_opacity",
      "label": "Background Image Opacity (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "color_background",
      "id": "bg_color_desktop",
      "label": "Desktop Background (Gradient)",
      "default": "linear-gradient(90deg, #F2EDF4 0%, #EEF1FA 45%, #E8F2FF 100%)"
    },
    {
      "type": "color",
      "id": "bg_color_desktop_solid",
      "label": "Desktop Background (Solid Color)",
      "default": "transparent"
    },
    {
      "type": "color_background",
      "id": "bg_color_mobile",
      "label": "Mobile Background (Gradient)",
      "default": "linear-gradient(90deg, #F2EDF4 0%, #EEF1FA 45%, #E8F2FF 100%)"
    },
    {
      "type": "color",
      "id": "bg_color_mobile_solid",
      "label": "Mobile Background (Solid Color)",
      "default": "transparent"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Partners"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading type",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style Preset",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "Paragraph (P)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_style_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_style_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_style_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.heading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading Style Preset",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "Paragraph (P)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "p"
    },
    {
      "type": "range",
      "id": "subheading_style_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.subheading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "subheading_style_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.subheading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subheading_style_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.subheading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "subheading_style_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.subheading_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "subheading_style_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.subheading_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "subheading_style_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.subheading_style == 'custom' }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#001755"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding Top (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding Bottom (Desktop)"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "Padding Top (Mobile)"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "Padding Bottom (Mobile)"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Carousel"
    }
  ]
}
{% endschema %}
<script src="{{ 'sonu-logo-list.js' | asset_url }}" defer="defer"></script>
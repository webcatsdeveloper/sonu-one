<section class="sonu-careers-positions section-{{ section.id }}" style="
  {% if section.settings.bg_gradient != blank %}
    background: {{ section.settings.bg_gradient }};
  {% elsif section.settings.bg_color != blank %}
    background-color: {{ section.settings.bg_color }};
  {% endif %}
  --padding-top: {{ section.settings.padding_top | default: 80 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile | default: 60 }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
">
  <style>
    #shopify-section-{{ section.id }} .sonu-careers-positions {
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
    }
    #shopify-section-{{ section.id }} .careers-positions-container {
      /* Spacing and width constraints are handled by global .page-width */
      max-width: 1060px; /* Aligns with the 1060px grid width of the hero/offer sections */
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .careers-positions-header {
      padding-bottom: 24px;
      border-bottom: 1px solid #000000;
      margin-bottom: 0;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .careers-positions-heading {
      color: #000000;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .careers-positions-list {
      display: flex;
      flex-direction: column;
      width: 100%;
      border-bottom: 1px solid #000000;
    }
    #shopify-section-{{ section.id }} .position-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 28px 0;
      text-decoration: none;
      transition: background-color 0.25s ease;
    }
    #shopify-section-{{ section.id }} .position-left-col {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
      padding-right: 32px;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .position-title {
      color: #000000;
      margin: 0;
      transition: color 0.25s ease;
    }
    #shopify-section-{{ section.id }} .position-right-col {
      display: flex;
      align-items: center;
      gap: 32px;
      flex-shrink: 0;
    }
    #shopify-section-{{ section.id }} .position-count {
      color: #727272;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .position-arrow-icon {
      width: 24px;
      height: 24px;
      display: block;
      transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    #shopify-section-{{ section.id }} .position-arrow-icon circle {
      stroke: #000000;
      transition: stroke 0.25s ease;
    }
    #shopify-section-{{ section.id }} .position-arrow-icon path {
      stroke: #000000;
      transition: stroke 0.25s ease;
    }

    /* Hover Micro-animations */
    #shopify-section-{{ section.id }} .position-item:hover .position-title {
      color: #727272;
    }
    #shopify-section-{{ section.id }} .position-item:hover .position-arrow-icon circle {
      stroke: #727272;
    }
    #shopify-section-{{ section.id }} .position-item:hover .position-arrow-icon path {
      stroke: #727272;
    }
    #shopify-section-{{ section.id }} .position-item:hover .position-arrow-icon {
      transform: scale(1.1) translate(2px, -2px);
    }

    /* Highlights styling overrides */
    #shopify-section-{{ section.id }} .highlight-times {
      font-family: 'Times New Roman', Times, Georgia, serif !important;
      font-style: italic !important;
    }
    #shopify-section-{{ section.id }} .highlight-pp {
      font-family: var(--font-highlight--family, serif) !important;
      font-style: var(--font-highlight--style, italic) !important;
    }

    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .sonu-careers-positions {
        padding-top: var(--padding-top-mobile) !important;
        padding-bottom: var(--padding-bottom-mobile) !important;
      }
      #shopify-section-{{ section.id }} .position-item {
        padding: 20px 0;
      }
      #shopify-section-{{ section.id }} .position-left-col {
        padding-right: 16px;
        gap: 8px;
      }
      #shopify-section-{{ section.id }} .position-right-col {
        gap: 16px;
      }
    }
  </style>

  <div class="careers-positions-container page-width">
    {%- if section.settings.heading != blank -%}
      <div class="careers-positions-header">
        {%- assign formatted_heading = section.settings.heading 
          | replace: '[[', '<em class="highlight-pp">' | replace: ']]', '</em>' 
          | replace: '((', '<span class="highlight-times">' | replace: '))', '</span>' -%}
        <h2 class="careers-positions-heading typography-{{ section.settings.heading_style | default: 'h2' }}" 
            style="{% render 'sonu-typography-style', preset: section.settings.heading_style, prefix: 'heading_style', settings: section.settings %}">
          {{ formatted_heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="careers-positions-list">
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="position-item" {{ block.shopify_attributes }}>
              <div class="position-left-col">
                <span class="position-title typography-{{ section.settings.position_title_style | default: 'h3' }}" 
                      style="{% render 'sonu-typography-style', preset: section.settings.position_title_style, prefix: 'position_title_style', settings: section.settings %}">
                  {{ block.settings.title | escape }}
                </span>
              </div>
              <div class="position-right-col">
                {%- if block.settings.count_text != blank -%}
                  <span class="position-count typography-{{ section.settings.position_count_style | default: 'p' }}" 
                        style="{% render 'sonu-typography-style', preset: section.settings.position_count_style, prefix: 'position_count_style', settings: section.settings %}">
                    {{ block.settings.count_text | escape }}
                  </span>
                {%- endif -%}
                <svg class="position-arrow-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="16" r="14" stroke="#000000" stroke-width="1.5"/>
                  <path d="M12 20L20 12M20 12H14.5M20 12V17.5" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}

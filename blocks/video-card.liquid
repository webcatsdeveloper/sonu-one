{% liquid
  assign info_classes = 'color-' | append: block.settings.color_scheme
%}

{% capture information %}
  {% content_for 'block', type: '_video-card-info', id: 'video-card-info', classes: info_classes %}
{% endcapture %}
{% render 'video-card', block: block, information: information %}
{% schema %}
{
  "name": "t:names.video_card",
  "tag": null,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:settings.cover_image"
    },
    {
      "type": "header",
      "content": "t:settings.size"
    },
    {
      "type": "select",
      "id": "video_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "1/1",
          "label": "t:options.square"
        },
        {
          "value": "4/5",
          "label": "t:options.portrait"
        },
        {
          "value": "3/4",
          "label": "t:options.portrait_3_4"
        },
        {
          "value": "16/9",
          "label": "t:options.landscape"
        },
        {
          "value": "4/3",
          "label": "t:options.landscape_4_3"
        },
        {
          "value": "21/9",
          "label": "t:options.landscape_21_9"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_mobile_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_mobile_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_mobile_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_mobile_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.video_card",
      "category": "t:categories.basic",
      "settings": {
        "color_scheme": "scheme-inverse",
        "border_radius": 20
      }
    }
  ]
}
{% endschema %}

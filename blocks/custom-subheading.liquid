{% capture highlighted_text %}
  {{ block.settings.text
    | replace: '[[', '<span class="sonu-highlight">'
    | replace: ']]', '</span>'
  }}
{% endcapture %}

{% render 'text',
  block: block,
  text: highlighted_text
%}
{% schema %}
{
  "name": "Custom Subheading",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Subheading Text",
      "default": "<p>Your subheading here</p>"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "text_alignment",
      "id": "custom_text_alignment",
      "label": "Text Alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Typography",
      "options": [
        {
          "value": "text-subheading",
          "label": "Subheading"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "text-subheading"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit Content"
        },
        {
          "value": "100%",
          "label": "Full Width"
        }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit Content"
        },
        {
          "value": "100%",
          "label": "Full Width"
        }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "subtext",
          "label": "Subtext"
        }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font Family",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "Body Font"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "Heading Font"
        }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "id": "font_weight",
      "type": "select",
      "label": "Font Weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Inherit"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (Desktop)",
      "default": 15,
      "min": 12,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size (Mobile)",
      "default": 15,
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line Height",
      "options": [
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "loose",
          "label": "Loose"
        }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    {
      "name": "Custom Subheading",
      "category": "Basic"
    }
  ]
}
{% endschema %}

<style>
@font-face {
  font-family: 'pp-editorial';
  src: url('{{ "PPEditorialNew-RegularItalic.woff2" | asset_url }}') format('woff2');
}

/* Force Instrument Sans on this block only by default */
.text-block--{{ block.id }},
.text-block--{{ block.id }} * {
  font-family: var(--font-family, 'Instrument Sans', sans-serif) !important;
  font-weight: var(--custom-font-weight, var(--font-weight, 500)) !important;
}

/* Override highlighted text */
.text-block--{{ block.id }} .sonu-highlight {
  font-family: 'pp-editorial' !important;
  font-style: italic;
  font-weight: 400 !important;
}
</style>
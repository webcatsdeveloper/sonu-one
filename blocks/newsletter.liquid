{%- liquid
  assign block_class = ''
  assign block_class = block_class | append: ' items-' | append: block.settings.text_align | replace: 'left', 'start'
-%}
<div
  class="newsletter size-style flex flex-col{{ block_class }} text-{{ block.settings.text_align }}"
  {{ block.shopify_attributes }}
  style="{% render 'size-style', settings: block.settings %}"
>
  <div class="newsletter-form__wrapper flex flex-col gap-4 w-full">
    {% render 'newsletter-form', block_id: section.id, design: 'design-1' %}
    {%- if block.settings.newsletter_term != blank -%}
      <div class="rte text-body-sm color-{{ block.settings.newsletter_term_text_color }}">
        {{ block.settings.newsletter_term }}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "t:names.newsletter",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "text_align",
      "label": "t:settings.text_align",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.terms_and_policy"
    },
    {
      "type": "richtext",
      "id": "newsletter_term",
      "label": "t:settings.text",
      "default": "<p>By subscribing you agree to the <a href='#'>Terms of Use</a> & <a href='#'>Privacy Policy.</a></p>"
    },
    {
      "type": "select",
      "id": "newsletter_term_text_color",
      "label": "t:settings.color",
      "options": [
        {
          "value": "text",
          "label": "t:options.text"
        },
        {
          "value": "subtext",
          "label": "t:options.subtext"
        }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_mobile_font_size_desktop",
      "label": "Desktop Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_mobile_font_size_mobile",
      "label": "Mobile Font Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile_font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400",
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_mobile_line_height",
      "label": "Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "width_mobile_letter_spacing",
      "label": "Letter Spacing (hundredths of em)",
      "min": -10,
      "max": 50,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.newsletter",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}

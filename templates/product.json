        "custom_liquid": "<style>\n    .steps-section {\n      padding: 40px 20px;\n      text-align: center;\n      background-color: #f8f9fa;\n    }\n\n    .steps-section h2 {\n      font-size: 2em;\n      margin-bottom: 30px;\n      color: #333;\n    }\n\n    .steps-grid {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 20px;\n      justify-content: center;\n    }\n\n    .step {\n      flex: 1 1 400px;\n      max-width: 400px;\n      background: #fff;\n      border-radius: 15px;\n      overflow: hidden;\n      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\n      transition: transform 0.3s ease;\n    }\n\n    .step:hover {\n      transform: translateY(-5px);\n    }\n\n    .step img {\n      width: 100%;\n      height: auto;\n      display: block;\n    }\n\n    .step p {\n      padding: 15px;\n      font-size: 1em;\n      color: #555;\n    }\n\n    @media (max-width: 768px) {\n      .steps-grid {\n        flex-direction: column;\n        align-items: center;\n      }\n.step {\n    flex: 1;\n    }\n  </style>\n\n  <section class=\"steps-section\">\n    <h2>3 Simple Steps to a Better Life</h2>\n    <div class=\"steps-grid\">\n      <div class=\"step\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0722/0507/4691/files/Screenshot_2025-05-14_031728.png?v=1747173040\" alt=\"Step 1\">\n       \n      </div>\n      <div class=\"step\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0722/0507/4691/files/Screenshot_2025-05-14_031748.png?v=1747173041\" alt=\"Step 2\">\n     \n      </div>\n      <div class=\"step\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0722/0507/4691/files/Screenshot_2025-05-14_031809.png?v=1747173041\" alt=\"Step 3\">\n       \n      </div>\n    </div>\n  </section>"

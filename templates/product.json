      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<div id=\"partner-banner\" class=\"partner-banner\" style=\"display:none;\">\n  \n  <div class=\"partner-inner\">\n\n    <div class=\"partner-badge\">\n      <span class=\"badge-dot\" style=\"display:none;\"></span>\n      Official Partner\n    </div>\n\n    <div class=\"partner-logos\">\n      <img id=\"partner-logo\" class=\"partner-logo\" src=\"\" alt=\"Partner Logo\">\n      <span class=\"partner-cross\">×</span>\n      <img class=\"brand-logo\" src=\"https://soundhealth.life/cdn/shop/files/logo_soundhealth_email.png?v=1729133155&width=400\" alt=\"Sound Health\">\n    </div>\n\n  </div>\n\n</div>\n\n<style>\n.partner-banner {\n  margin-bottom: 20px;\n  border-radius: 0px;\n  padding: 24px;\n  border: 1px solid #e0e6ed;\n  box-shadow: 0 10px 30px rgba(0,0,0,0.05);\n  transition: all 0.3s ease;\n  animation: fadeSlide 0.5s ease forwards;\n}\n\n.partner-inner {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n}\n\n.partner-logos {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.partner-logo,\n.brand-logo {\n  height: 36px;\n  object-fit: contain;\n}\n\n.partner-cross {\n  font-size: 18px;\n  font-weight: 600;\n  color: #333;\n}\n\n.partner-badge {\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: #1e88e5;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.badge-dot {\n  width: 8px;\n  height: 8px;\n  background: #1e88e5;\n  border-radius: 50%;\n}\n\n@keyframes fadeSlide {\n  from { opacity:0; transform:translateY(-6px); }\n  to { opacity:1; transform:translateY(0); }\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n\n  const approvedPartners = {\n\n    dentulu: {\n      name: \"Dentulu\",\n      logo: \"https://www.dentulu.com/assets/new-source/img/home/header/logo.svg\",\n      bg: \"#141B5D\",\n      badgeColor: \"#ffffff\",\n      dotColor: \"#ffffff\",\n      crossColor: \"#ffffff\",\n      ctaBg: \"#141B5D\",\n      ctaText: \"#ffffff\",\n      brandFilter: \"brightness(14.5)\",\n      partnerLogoFilter: \"brightness(10)\"\n    },\n\n    spinta: {\n      name: \"Spinta Digital\",\n      logo: \"https://spintadigital.com/wp-content/uploads/2023/11/spintadigital-black-logo-webp.webp\",\n      bg: \"#FFFFFF\",\n      badgeColor: \"#000000\",\n      dotColor: \"#000000\",\n      crossColor: \"#000000\",\n      ctaBg: \"#000000\",\n      ctaText: \"#ffffff\"\n    },\n\n    sleeptest: {\n      name: \"Sleep Test\",\n      logo: \"https://cdn.shopify.com/s/files/1/0722/0507/4691/files/SleepTest_Logo-RGB.png?v=1773169224\",\n      bg: \"#0079c1\",\n      badgeColor: \"#ffffff\",\n      dotColor: \"#ffffff\",\n      crossColor: \"#ffffff\",\n      ctaBg: \"#0079c1\",\n      ctaText: \"#ffffff\",\n      brandFilter: \"brightness(14.5)\",\n      partnerLogoFilter: \"brightness(10)\"\n    }\n\n  };\n\n  /* ==============================\n     PARTNER DETECTION FROM URL\n     ============================== */\n\n  const urlParams = new URLSearchParams(window.location.search);\n  const partner = urlParams.get(\"partner\");\n\n  if (partner && approvedPartners[partner]) {\n\n    const partnerData = approvedPartners[partner];\n\n    // Banner\n    const banner = document.getElementById(\"partner-banner\");\n    if (banner) {\n      banner.style.background = partnerData.bg;\n      banner.style.display = \"block\";\n    }\n\n    // Partner Logo\n    const logo = document.getElementById(\"partner-logo\");\n    if (logo) {\n      logo.src = partnerData.logo;\n      logo.style.filter = partnerData.partnerLogoFilter || \"none\";\n    }\n\n    // Brand Logo Filter\n    const brandLogo = document.querySelector(\".brand-logo\");\n    if (brandLogo) {\n      brandLogo.style.filter = partnerData.brandFilter || \"none\";\n    }\n\n    // Badge Colors\n    const badge = document.querySelector(\".partner-badge\");\n    if (badge) badge.style.color = partnerData.badgeColor;\n\n    const dot = document.querySelector(\".badge-dot\");\n    if (dot) dot.style.background = partnerData.dotColor;\n\n    const cross = document.querySelector(\".partner-cross\");\n    if (cross) cross.style.color = partnerData.crossColor;\n\n    // Change ALL Add To Cart Buttons (main + sticky)\n    const allAddButtons = document.querySelectorAll('button[name=\"add\"]');\n\n    allAddButtons.forEach(function(btn) {\n      btn.style.background = partnerData.ctaBg;\n      btn.style.color = partnerData.ctaText;\n      btn.style.border = \"none\";\n      btn.style.transition = \"all 0.3s ease\";\n    });\n\n  }\n\n});\n</script>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n\n  const params = new URLSearchParams(window.location.search);\n  const discount = params.get(\"discount\");\n\n  if (discount && !sessionStorage.getItem(\"discount_applied\")) {\n\n    sessionStorage.setItem(\"discount_applied\", \"true\");\n\n    const redirectPath = window.location.pathname + window.location.search;\n\n    window.location.href = \"/discount/\" + discount + \"?redirect=\" + encodeURIComponent(redirectPath);\n\n  }\n\n});\n</script>"
      }
    },

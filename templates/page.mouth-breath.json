n}\n\n.hero h1 {\n  font-size: clamp(2.2rem, 5.5vw, 4.2rem);\n  color: var(--white);\n  line-height: 1.15;\n  max-width: 820px;\n  margin-bottom: 1.5rem;\n  opacity: 0;\n  animation: fadeUp 0.8s 0.4s forwards;\n}\n\n.hero h1 em {\n  font-style: normal;\n  color: var(--orangebg);\n}\n\n.hero-sub {\n  font-size: clamp(1rem, 2vw, 1.2rem);\n  max-width: 600px;\n  margin-bottom: 2.5rem;\n  color: var(--white);\n  font-weight: 300;\n  opacity: 0;\n  animation: fadeUp 0.8s 0.6s forwards;\n}\n\n.hero-cta-group {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.75rem;\n  opacity: 0;\n  animation: fadeUp 0.8s 0.8s forwards;\n}\n\n.btn-primary {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.6rem;\n  padding: .5rem 1.4rem !important;\nbackground: var(--orangebg);\n  color: var(--white);\n  font-weight: 600;\n  font-size: 1rem !important;\n  border: none;\n  border-radius: 10px;\n  cursor: pointer;\n  text-decoration: none;\n  transition: transform 0.25s, box-shadow 0.25s;\n  box-shadow: 0 4px 30px rgba(232,132,92,0.3);\n}\n\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 40px rgba(232,132,92,0.45);\n}\n\n.hero-trust {\n  font-size: 0.78rem;\n  color: var(--white);\n  letter-spacing: 0.04em;\n}\n\n/* ==================== IMAGE PLACEHOLDERS ==================== */\n.visual-asset {\n  background: var(--glow-blue);\n  border: 1px dashed rgba(123,140,222,0.3);\n  border-radius: 16px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 1rem 1rem;\n  text-align: center;\n  color: var(--lavender);\n  font-size: 0.85rem;\n  line-height: 1.5;\n  min-height: 260px;\n}\n.problem-visual{\nwidth:max-content;\n}\n@media (max-width:600px){\n.problem-visual{\nwidth:auto;\n\n}\n}\n\n.visual-asset .icon {\n  font-size: 2.5rem;\n  margin-bottom: 0.75rem;\n  opacity: 0.7;\n}\n\n.visual-asset .asset-label {\n  font-weight: 600;\n  font-size: 0.9rem;\n  margin-bottom: 0.35rem
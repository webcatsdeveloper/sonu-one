{% style %}
  {%- comment -%}
    Optimized font-face loading (compact)
    - Iterate roles and variants; emit once per variant
  {%- endcomment -%}

  {%- liquid
    assign loaded = ''
    assign roles = 'body,head,highlight,highlight_secondary' | split: ','
    assign variants = 'regular|normal, bold|normal, regular|italic, bold|italic' | split: ','

    # Parse extra weights from settings
    assign body_extra_weights_array = settings.body_extra_weights | strip | split: ','
    assign heading_extra_weights_array = settings.heading_extra_weights | strip | split: ','
  %}

  {%- for role in roles -%}
    {%- liquid
      assign base = nil
      assign extra_weights_array = ''
      case role
        when 'body'
          assign base = settings.type_body_font
          assign extra_weights_array = body_extra_weights_array
        when 'head'
          assign base = settings.type_heading_font
          assign extra_weights_array = heading_extra_weights_array
        when 'highlight'
          assign base = settings.type_highlight_font
        when 'highlight_secondary'
          assign base = settings.type_highlight_font_secondary
      endcase
      if base == blank or base == 'Instrument Sans' or base == 'PP Editorial New' or base == 'instrument-sans' or base == 'pp-editorial' or base == 'Times New Roman'
        continue
      endif
    -%}
    {%- for variant in variants -%}
      {%- liquid
        assign variant_parts = variant | strip | split: '|'
        assign weight = variant_parts[0] | strip
        assign style = variant_parts[1] | strip
        assign font_to_load = base

        if weight == 'bold'
          assign font_to_load = font_to_load | font_modify: 'weight', 'bold'
        endif
        if style == 'italic'
          assign font_to_load = font_to_load | font_modify: 'style', 'italic'
        endif

        assign url = font_to_load | font_url
        assign key = url | default: role
      -%}
      {%- unless loaded contains key -%}
        {{ font_to_load | font_face: font_display: 'swap' }}
        {%- assign loaded = loaded | append: key | append: '|' -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- comment -%} Load extra weights for body and heading fonts {%- endcomment -%}
    {%- if extra_weights_array != blank and extra_weights_array.size > 0 -%}
      {%- assign extra_styles = 'normal,italic' | split: ',' -%}
      {%- for extra_weight in extra_weights_array -%}
        {%- liquid
          assign weight_value = extra_weight | strip
          if weight_value == blank
            continue
          endif
        -%}
        {%- for style_value in extra_styles -%}
          {%- liquid
            assign font_to_load = base | font_modify: 'weight', weight_value
            if style_value == 'italic'
              assign font_to_load = font_to_load | font_modify: 'style', 'italic'
            endif
            assign url = font_to_load | font_url
            assign key = url | default: role
          -%}
          {%- unless loaded contains key -%}
            {{ font_to_load | font_face: font_display: 'swap' }}
            {%- assign loaded = loaded | append: key | append: '|' -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

  :root {
    /* Page layout */
    --page-width: {{ settings.page_width | divided_by: 10.0 }}rem;
    --page-width-narrow: 88.0rem;

    --logo-width: {{ settings.logo_width }}px;
    --logo-width-mobile: {{ settings.logo_width_mobile }}px;
    --logo-width-menu-drawer: {{ settings.logo_width_menu_drawer }}px;

    /* Typography presets */
    --font-size--mega-title: {{ settings.type_h1_size_mobile | divided_by: 10.0 }}rem;
    --font-size--h1: {{ settings.type_h1_size_mobile | divided_by: 10.0 }}rem;
    --font-size--h2: {{ settings.type_h2_size_mobile | divided_by: 10.0 }}rem;
    --font-size--h3: {{ settings.type_h3_size_mobile | divided_by: 10.0 }}rem;
    --font-size--h4: {{ settings.type_h4_size_mobile | divided_by: 10.0 }}rem;
    --font-size--h5: {{ settings.type_h5_size_mobile | divided_by: 10.0 }}rem;
    --font-size--h6: {{ settings.type_h6_size_mobile | divided_by: 10.0 }}rem;
    --font-size--paragraph: {{ settings.type_p_size_mobile | divided_by: 10.0 }}rem;
    --font-size--paragraph-small: {{ settings.type_p_size_mobile | divided_by: 10.0 | times: 0.9 | round: 2 }}rem;

    --font-mega-title--line-height: {{ settings.type_h1_line_height }};
    --font-h1--line-height: {{ settings.type_h1_line_height }};
    --font-h2--line-height: {{ settings.type_h2_line_height }};
    --font-h3--line-height: {{ settings.type_h3_line_height }};
    --font-h4--line-height: {{ settings.type_h4_line_height }};
    --font-h5--line-height: {{ settings.type_h5_line_height }};
    --font-h6--line-height: {{ settings.type_h6_line_height }};
    --font-paragraph--line-height: {{ settings.type_p_line_height }};

    --font-h1--weight: {{ settings.type_h1_weight | default: '400' }};
    --font-h2--weight: {{ settings.type_h2_weight | default: '400' }};
    --font-h3--weight: {{ settings.type_h3_weight | default: '400' }};
    --font-h4--weight: {{ settings.type_h4_weight | default: '400' }};
    --font-h5--weight: {{ settings.type_h5_weight | default: '400' }};
    --font-h6--weight: {{ settings.type_h6_weight | default: '400' }};
    --font-body--weight: {{ settings.type_p_weight | default: '400' }};

    --font-h1--letter-spacing: {{ settings.type_h1_letter_spacing }}em;
    --font-h2--letter-spacing: {{ settings.type_h2_letter_spacing }}em;
    --font-h3--letter-spacing: {{ settings.type_h3_letter_spacing }}em;
    --font-h4--letter-spacing: {{ settings.type_h4_letter_spacing }}em;
    --font-h5--letter-spacing: {{ settings.type_h5_letter_spacing }}em;
    --font-h6--letter-spacing: {{ settings.type_h6_letter_spacing }}em;
    --font-paragraph--letter-spacing: {{ settings.type_p_letter_spacing }}em;

    --font-h1--transform: {{ settings.type_h1_text_transform }};
    --font-h2--transform: {{ settings.type_h2_text_transform }};
    --font-h3--transform: {{ settings.type_h3_text_transform }};
    --font-h4--transform: {{ settings.type_h4_text_transform }};
    --font-h5--transform: {{ settings.type_h5_text_transform }};
    --font-h6--transform: {{ settings.type_h6_text_transform }};
    --font-paragraph--transform: {{ settings.type_p_text_transform }};

    {%- liquid
      assign type_presets = "paragraph, h1, h2, h3, h4, h5, h6" | split: ", "

      for preset_name in type_presets
        assign preset_size = '--font-size--[preset_name]' | replace: '[preset_name]', preset_name

        if preset_name == 'paragraph'
          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

          echo '--font-[preset_name]--weight: var([preset_weight]);' | replace: '[preset_name]', preset_name | replace: '[preset_weight]', preset_weight
        else
          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-[preset_name]--weight' | replace: '[preset_name]', preset_name

          echo '--font-[preset_name]--weight: var([preset_weight]);' | replace: '[preset_name]', preset_name | replace: '[preset_weight]', preset_weight
        endif

        echo '--font-[preset_name]--size: var([preset_size]);' | replace: '[preset_name]', preset_name | replace: '[preset_size]', preset_size
        echo '--font-[preset_name]--family: var([preset_font]);' | replace: '[preset_name]', preset_name | replace: '[preset_font]', preset_font
        echo '--font-[preset_name]--style: var([preset_style]);' | replace: '[preset_name]', preset_name | replace: '[preset_style]', preset_style
      endfor
    -%}

    /* Line heights & spacings */
    --line-height--display-tight: 1;
    --line-height--display-normal: 1.1;
    --line-height--display-loose: 1.2;

    --line-height--heading-tight: 1.2;
    --line-height--heading-normal: 1.357;
    --line-height--heading-loose: 1.625;

    --line-height--subheading-tight: 1.2;
    --line-height--subheading-normal: 1.357;
    --line-height--subheading-loose: 1.625;

    --line-height--body-tight: 1.2;
    --line-height--body-normal: 1.4;
    --line-height--body-loose: 1.6;

    /* Spacing */
    --spacing-scale-sm: 0.6;
    --spacing-scale-md: 0.7;
    --spacing-scale-default: 1.0;
    --font-heading--spacing: clamp(2.4rem, .8em, 6rem);
    --font-paragraph--spacing: clamp(2.4rem, .8em, 6rem);

    /* Font families */
    {%- liquid
      if settings.type_body_font == 'instrument-sans' or settings.type_body_font == 'Instrument Sans'
        assign body_font_family = "'Instrument Sans', sans-serif"
        assign body_font_style = "normal"
        assign body_font_weight = "400"
      elsif settings.type_body_font == 'pp-editorial' or settings.type_body_font == 'PP Editorial New'
        assign body_font_family = "'PP Editorial New', 'pp-editorial', Georgia, serif"
        assign body_font_style = "normal"
        assign body_font_weight = "400"
      else
        assign body_font_family = settings.type_body_font.family | append: ', ' | append: settings.type_body_font.fallback_families
        assign body_font_style = settings.type_body_font.style
        assign body_font_weight = settings.type_body_font.weight
      endif

      if settings.type_heading_font == 'instrument-sans' or settings.type_heading_font == 'Instrument Sans'
        assign heading_font_family = "'Instrument Sans', sans-serif"
        assign heading_font_style = "normal"
        assign heading_font_weight = "400"
      elsif settings.type_heading_font == 'pp-editorial' or settings.type_heading_font == 'PP Editorial New'
        assign heading_font_family = "'PP Editorial New', 'pp-editorial', Georgia, serif"
        assign heading_font_style = "normal"
        assign heading_font_weight = "400"
      else
        assign heading_font_family = settings.type_heading_font.family | append: ', ' | append: settings.type_heading_font.fallback_families
        assign heading_font_style = settings.type_heading_font.style
        assign heading_font_weight = settings.type_heading_font.weight
      endif

      if settings.type_highlight_font == 'instrument-sans' or settings.type_highlight_font == 'Instrument Sans'
        assign highlight_font_family = "'Instrument Sans', sans-serif"
        assign highlight_font_style = "normal"
        assign highlight_font_weight = "400"
      elsif settings.type_highlight_font == 'pp-editorial' or settings.type_highlight_font == 'PP Editorial New'
        assign highlight_font_family = "'PP Editorial New', 'pp-editorial', Georgia, serif"
        assign highlight_font_style = "italic"
        assign highlight_font_weight = "400"
      elsif settings.type_highlight_font == 'Times New Roman'
        assign highlight_font_family = "'Times New Roman', Times, Georgia, serif"
        assign highlight_font_style = "italic"
        assign highlight_font_weight = "400"
      else
        assign highlight_font_family = settings.type_highlight_font.family | append: ', ' | append: settings.type_highlight_font.fallback_families
        assign highlight_font_style = settings.type_highlight_font.style
        assign highlight_font_weight = settings.type_highlight_font.weight
      endif

      if settings.type_highlight_font_secondary == 'instrument-sans' or settings.type_highlight_font_secondary == 'Instrument Sans'
        assign highlight_font_family_secondary = "'Instrument Sans', sans-serif"
        assign highlight_font_style_secondary = "normal"
        assign highlight_font_weight_secondary = "400"
      elsif settings.type_highlight_font_secondary == 'pp-editorial' or settings.type_highlight_font_secondary == 'PP Editorial New'
        assign highlight_font_family_secondary = "'PP Editorial New', 'pp-editorial', Georgia, serif"
        assign highlight_font_style_secondary = "italic"
        assign highlight_font_weight_secondary = "400"
      elsif settings.type_highlight_font_secondary == 'Times New Roman' or settings.type_highlight_font_secondary == blank
        assign highlight_font_family_secondary = "'Times New Roman', Times, Georgia, serif"
        assign highlight_font_style_secondary = "italic"
        assign highlight_font_weight_secondary = "400"
      else
        assign highlight_font_family_secondary = settings.type_highlight_font_secondary.family | append: ', ' | append: settings.type_highlight_font_secondary.fallback_families
        assign highlight_font_style_secondary = settings.type_highlight_font_secondary.style
        assign highlight_font_weight_secondary = settings.type_highlight_font_secondary.weight
      endif
    -%}
    --font-body--family: {{ body_font_family }};
    --font-body--style: {{ body_font_style }};
    --font-body--weight: {{ body_font_weight }};

    --font-subheading--family: {{ heading_font_family }};
    --font-subheading--style: {{ heading_font_style }};
    --font-subheading--weight: var(--font-h6--weight);
    --font-subheading--transform: var(--font-h6--transform);
    --font-subheading--letter-spacing: var(--font-h6--letter-spacing);
    --font-subheading--size-scale: 1.0;
    --font-subheading--size: var(--font-size--h6);

    --font-pcard-title--family: {{ body_font_family }};
    --font-pcard-title--style: {{ body_font_style }};
    --font-pcard-title--weight: var(--font-body--weight);
    --font-pcard-title--size-scale: 1.0;
    --font-pcard-title--size: var(--font-size--paragraph);

    --font-pcard-price--family: {{ heading_font_family }};
    --font-pcard-price--style: {{ heading_font_style }};
    --font-pcard-price--weight: var(--font-h6--weight);

    --font-pcard-badge--family: {{ body_font_family }};
    --font-pcard-badge--style: {{ body_font_style }};
    --font-pcard-badge--weight: var(--font-body--weight);
    --font-pcard-badge--transform: uppercase;
    --font-pcard-badge--letter-spacing: 0.05em;

    --font-navigation--family: {{ body_font_family }};
    --font-navigation--style: {{ body_font_style }};
    --font-navigation--weight: var(--font-body--weight);
    --font-navigation--transform: none;
    --font-navigation--letter-spacing: 0em;

    --font-button--family: {{ heading_font_family }};
    --font-button--style: {{ heading_font_style }};
    --font-button--weight: var(--font-h6--weight);

    --font-heading--family: {{ heading_font_family }};
    --font-heading--style: {{ heading_font_style }};
    --font-heading--weight: {{ heading_font_weight }};

    --font-highlight--family: {{ highlight_font_family }};
    --font-highlight--style: {{ highlight_font_style }};
    --font-highlight--weight: {{ highlight_font_weight }};

    --font-highlight-secondary--family: {{ highlight_font_family_secondary }};
    --font-highlight-secondary--style: {{ highlight_font_style_secondary }};
    --font-highlight-secondary--weight: {{ highlight_font_weight_secondary }};

    /* Buttons */
    --font-button--transform: {{ settings.button_text_transform }};
    --font-button--letter-spacing: {{ settings.button_letter_spacing | divided_by: 100.0 }}em;

    /* Inputs */
    --select-arrow-icon: url('{{ 'icon-select-arrow.svg' | asset_url }}');
    --input-border-radius: {{ settings.input_corner_radius | divided_by: 10.0 }}rem;
    --input-height: {{ settings.input_height | divided_by: 10.0 }}rem;
    --input-border-width: {{ settings.input_border_width | divided_by: 10.0 }}rem;
    --textareas-radius:  min({{ settings.input_corner_radius | divided_by: 10.0 }}rem, 1rem);
    /* Buttons */
    --button-height: {{ settings.button_height | divided_by: 10.0 }}rem;
    --button-corner-radius: {{ settings.button_corner_radius | divided_by: 10.0 }}rem;
    --button-border-thickness: {{ settings.button_border_thickness | divided_by: 10.0 }}rem;

    /* Z-index */
    --layer-section-background: -2;
    --layer-lowest: -1;
    --layer-base: 0;
    --layer-flat: 1;
    --layer-raised: 2;
    --layer-heightened: 4;
    --layer-sticky: 8;
    --layer-window-overlay: 10;
    --layer-header-menu: 12;
    --layer-overlay: 16;
    --layer-menu-drawer: 18;
    --layer-temporary: 40;

    /* Badges */
    --color-new-badge-background: {{ settings.new_badge_background.rgb }};
    --color-new-badge-text: {{ settings.new_badge_text.rgb }};
    --color-hot-badge-background: {{ settings.hot_badge_background.rgb }};
    --color-hot-badge-text: {{ settings.hot_badge_text.rgb }};
    --color-popular-badge-background: {{ settings.popular_badge_background.rgb }};
    --color-popular-badge-text: {{ settings.popular_badge_text.rgb }};
    --color-sale-badge-background: {{ settings.sale_badge_background.rgb }};
    --color-sale-badge-text: {{ settings.sale_badge_text.rgb }};
    --color-sold-out-badge-background: {{ settings.sold_out_badge_background.rgb }};
    --color-sold-out-badge-text: {{ settings.sold_out_badge_text.rgb }};
    --color-cart-bubble-text: {{ settings.cart_bubble_text }};
    --color-cart-bubble-background: {{ settings.cart_bubble_background }};
    --badge-corner-radius: {{ settings.badge_corner_radius | divided_by: 10.0 }}rem;

    /* Hardcoded Color */
    --color-white: 255 255 255;
    --color-black: 0 0 0;
    --color-focus-ring: 27 87 192;

    /* Product card */
    --product-card-media-radius: {{ settings.pcard_media_radius | divided_by: 10.0 }}rem;

    /* Dialog */
    --dialog-radius: {{ settings.dialog_radius | divided_by: 10.0 }}rem;
    --dialog-backdrop-opacity: 60%;
  }

  @media screen and (min-width: 768px) {
    :root {
      --font-size--mega-title: {{ settings.type_h1_size | divided_by: 10.0 }}rem;
      --font-size--h1: {{ settings.type_h1_size | divided_by: 10.0 }}rem;
      --font-size--h2: {{ settings.type_h2_size | divided_by: 10.0 }}rem;
      --font-size--h3: {{ settings.type_h3_size | divided_by: 10.0 }}rem;
      --font-size--h4: {{ settings.type_h4_size | divided_by: 10.0 }}rem;
      --font-size--h5: {{ settings.type_h5_size | divided_by: 10.0 }}rem;
      --font-size--h6: {{ settings.type_h6_size | divided_by: 10.0 }}rem;
      --font-size--paragraph: {{ settings.type_p_size | divided_by: 10.0 }}rem;
      --font-size--paragraph-small: {{ settings.type_p_size | divided_by: 10.0 | times: 0.9 | round: 2 }}rem;
      --font-subheading--size: var(--font-size--h6);
      --font-pcard-title--size: var(--font-size--paragraph);
    }
  }

  /* Centralized global typography utility classes */
  .typography-h1, .text-block.h1, h1, .h1, .text-block.h1 > * {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--h1) !important;
    line-height: var(--font-h1--line-height) !important;
    font-weight: var(--font-h1--weight) !important;
    letter-spacing: var(--font-h1--letter-spacing) !important;
    text-transform: var(--font-h1--transform) !important;
  }
  .typography-h2, .text-block.h2, h2, .h2, .text-block.h2 > * {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--h2) !important;
    line-height: var(--font-h2--line-height) !important;
    font-weight: var(--font-h2--weight) !important;
    letter-spacing: var(--font-h2--letter-spacing) !important;
    text-transform: var(--font-h2--transform) !important;
  }
  .typography-h3, .text-block.h3, h3, .h3, .text-block.h3 > * {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--h3) !important;
    line-height: var(--font-h3--line-height) !important;
    font-weight: var(--font-h3--weight) !important;
    letter-spacing: var(--font-h3--letter-spacing) !important;
    text-transform: var(--font-h3--transform) !important;
  }
  .typography-h4, .text-block.h4, h4, .h4, .text-block.h4 > * {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--h4) !important;
    line-height: var(--font-h4--line-height) !important;
    font-weight: var(--font-h4--weight) !important;
    letter-spacing: var(--font-h4--letter-spacing) !important;
    text-transform: var(--font-h4--transform) !important;
  }
  .typography-h5, .text-block.h5, h5, .h5, .text-block.h5 > * {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--h5) !important;
    line-height: var(--font-h5--line-height) !important;
    font-weight: var(--font-h5--weight) !important;
    letter-spacing: var(--font-h5--letter-spacing) !important;
    text-transform: var(--font-h5--transform) !important;
  }
  .typography-h6, .text-block.h6, h6, .h6, .text-block.h6 > * {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-size--h6) !important;
    line-height: var(--font-h6--line-height) !important;
    font-weight: var(--font-h6--weight) !important;
    letter-spacing: var(--font-h6--letter-spacing) !important;
    text-transform: var(--font-h6--transform) !important;
  }
  .typography-p, .typography-paragraph, .text-block.paragraph, p, .paragraph, .text-block.paragraph > * {
    font-family: var(--font-body--family) !important;
    font-size: var(--font-size--paragraph) !important;
    line-height: var(--font-paragraph--line-height) !important;
    font-weight: var(--font-body--weight) !important;
    letter-spacing: var(--font-paragraph--letter-spacing) !important;
    text-transform: var(--font-paragraph--transform) !important;
  }
{% endstyle %}

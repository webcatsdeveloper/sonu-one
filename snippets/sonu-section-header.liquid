{%- comment -%}
  Renders a standardized section header with dynamic tags and formatting.
  
  Usage:
    render 'sonu-section-header',
      heading: section.settings.heading,
      heading_tag: section.settings.heading_tag,
      heading_class: 'main-heading',
      heading_style: heading_style,
      small_heading: section.settings.small_heading,
      subheading: section.settings.subheading,
      text_align: section.settings.text_align,
      animate: true
{%- endcomment -%}

{%- liquid
  assign tag = heading_tag | default: 'h2'
  assign class = heading_class | default: 'sonu-section-heading'
  assign h_style = heading_style_preset | default: tag
  assign sub_style = subheading_style_preset | default: 'p'
  assign small_style = small_heading_style_preset | default: 'p'
  assign align_class = 'text-left'
  if text_align == 'center'
    assign align_class = 'text-center'
  elsif text_align == 'right'
    assign align_class = 'text-right'
  endif

  assign resolved_settings = settings | default: section.settings
  assign h_prefix = heading_style_prefix | default: 'heading_style'
  assign sub_prefix = subheading_style_prefix | default: 'subheading_style'
  assign small_prefix = small_heading_style_prefix | default: 'small_heading_style'
-%}
{%- capture newline -%}
{%- endcapture -%}
{%- capture double_br -%}<br />
<br />{%- endcapture -%}
{%- capture double_br_short -%}<br>
<br>{%- endcapture -%}
{%- capture single_br -%}<br />{%- endcapture -%}

<div class="sonu-section-header {{ align_class }} {% if animate %}sonu-blur-in{% endif %}">
  {%- if small_heading != blank -%}
    <p class="sonu-section-header__small-heading typography-{{ small_style }}"
       style="{% render 'sonu-typography-style', preset: small_style, prefix: small_prefix, settings: resolved_settings %}">
      {{ small_heading | escape }}
    </p>
  {%- endif -%}

  {%- if heading != blank -%}
    {%- capture heading_with_br -%}
      {%- render 'heading-br', heading: heading -%}
    {%- endcapture -%}
    {%- assign formatted_heading = heading_with_br
      | replace: '<br>', newline 
      | replace: '<br/>', newline 
      | replace: '<br />', newline 
      | replace: '[[', '<em class="highlight-text relative z--1 highlight-text--standard highlight-text--color-inherit animate" is="highlight-text" style="--hl-font-style: italic;">' 
      | replace: ']]', '</em>' 
      | newline_to_br 
      | replace: double_br, single_br
      | replace: double_br_short, single_br
    -%}
    <{{ tag }} class="{{ class }} typography-{{ h_style }}" 
      style="{{ heading_style }}{% render 'sonu-typography-style', preset: h_style, prefix: h_prefix, settings: resolved_settings %}">
      {{ formatted_heading }}
    </{{ tag }}>
  {%- endif -%}

  {%- if subheading != blank -%}
    {%- capture subheading_with_br -%}
      {%- render 'heading-br', heading: subheading -%}
    {%- endcapture -%}
    {%- assign formatted_subheading = subheading_with_br
      | replace: '<br>', newline 
      | replace: '<br/>', newline 
      | replace: '<br />', newline 
      | replace: '[[', '<em class="highlight-text relative z--1 highlight-text--standard highlight-text--color-inherit animate" is="highlight-text" style="--hl-font-style: italic;">' 
      | replace: ']]', '</em>' 
      | newline_to_br 
      | replace: double_br, single_br
      | replace: double_br_short, single_br
    -%}
    <div class="sonu-section-header__subheading typography-{{ sub_style }}"
         style="{% render 'sonu-typography-style', preset: sub_style, prefix: sub_prefix, settings: resolved_settings %}">
      {{ formatted_subheading }}
    </div>
  {%- endif -%}
</div>
